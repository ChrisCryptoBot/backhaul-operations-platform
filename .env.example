# The dispatcher desk reads and writes this database. Use a throwaway Postgres, never a database you care about:
#   docker run -d --name backhaul-demo-pg -e POSTGRES_PASSWORD=demo -e POSTGRES_USER=demo -e POSTGRES_DB=demo -p 54330:5432 postgres:16
DATABASE_URL=postgresql://demo:demo@localhost:54330/demo

# Optional. Only needed to read your own rate confirmation files; the two sample rate confirmations work without it.
ANTHROPIC_API_KEY=
# Live data for the desk, all server side. Leave blank to run on the canned samples and typed miles.
MAPBOX_ACCESS_TOKEN=
EIA_API_KEY=
FMCSA_WEBKEY=

# Sign-in (off by default; see docs/AUTH.md). With DESK_AUTH unset the desk is the demo's and nothing below is read.
DESK_AUTH=
# 32 or more random characters; signs the desk's own session cookie. Required when DESK_AUTH=on (without it nobody can sign in).
DESK_SESSION_SECRET=
# The people who run TrueLane (comma list of emails): the only ones who may read the sign-up requests.
DESK_ADMIN_EMAILS=
# The sign-in provider's keys (Clerk). The publishable key is read from either name.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
