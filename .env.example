# The dispatcher desk reads and writes this database. Use a throwaway Postgres, never a database you care about:
#   docker run -d --name backhaul-demo-pg -e POSTGRES_PASSWORD=demo -e POSTGRES_USER=demo -e POSTGRES_DB=demo -p 54330:5432 postgres:16
DATABASE_URL=postgresql://demo:demo@localhost:54330/demo

# Optional. Only needed to read your own rate confirmation files; the two sample rate confirmations work without it.
ANTHROPIC_API_KEY=
