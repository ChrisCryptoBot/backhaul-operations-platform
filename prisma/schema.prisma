generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════════════════════════
// TrueLane-shaped models (the demo's source of truth).
//
// These mirror TrueLane's `db/schema.ts` (WatermelonDB v56 / the synced Supabase tables): the same table
// and column names, snake_case in the database, camelCase here. Times are timestamptz here (the phone stores
// ms). The dispatcher layer (drivers, assignments) sits on top and is desktop-owned, as in the bridge
// contract (docs/CONVERGENCE_BUILD_PLAN.md): assignment is desktop-owned, execution is mobile-owned.
//
// The model names are TrueLane's own (the @@map table names match its tables). The old coordinator-task models
// (regions, weeks, drop lots, per-load task checklists and the rest) were dropped in 20261028010000.
// Status values are plain strings, as on the phone: draft | accepted | in_progress | completed | tonu | cancelled.
// ═══════════════════════════════════════════════════════════════════════════════════════════

/// The single demo workspace. Tenancy seam: TrueLane's user_id / Clerk org id lands here later.
model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  // Desk thresholds. Null means "use the default" (src/lib/thresholds.ts), so a fresh workspace needs no setup.
  emptyAmberPct         Decimal? @map("empty_amber_pct") @db.Decimal(5, 2)
  emptyRedPct           Decimal? @map("empty_red_pct") @db.Decimal(5, 2)
  defaultPayTermsDays   Int?     @map("default_pay_terms_days")
  detentionGraceMinutes Int?     @map("detention_grace_minutes")
  alertPickupHours      Int?     @map("alert_pickup_hours")
  alertSentHours        Int?     @map("alert_sent_hours")
  alertClearanceDays    Int?     @map("alert_clearance_days")
  laneMinLoads          Int?     @map("lane_min_loads")
  laneDays              Int?     @map("lane_days")
  /// Trailer dwell: hours an unhooked trailer may sit before it is a dwell alert, and the per-day charge after that. Null = the built-in default (48 hours, $75 a day); the company's figure wins, a person's typed figure on a trailer wins over both.
  dwellFreeHours        Int?     @map("dwell_free_hours")
  dwellPerDayRate       Decimal? @map("dwell_per_day_rate") @db.Decimal(8, 2)
  /// What the desk tells people about and when the weekly report goes (docs/SIGNALS.md). Null = the built-in default: block alerts only, report on, Monday 7 AM on the carrier clock.
  signalMinLevel        String?  @map("signal_min_level")
  reportDay             Int?     @map("report_day")
  reportHour            Int?     @map("report_hour")
  reportEnabled         Boolean? @map("report_enabled")
  /// The Leak Read intake (docs/LEAK_LEDGER.md): what the carrier says a mile costs (the fleet's, and a truck's own) and the detention terms they bill at (the fleet's, and a customer's own). It prices imported history, which carries no frozen floor and no frozen detention terms. Null = not filled in; the ledger then counts those loads and prices none.
  leakIntake            Json?    @map("leak_intake")
  /// The last statement number given out, so a discarded draft's number is never given again.
  settlementSeq         Int      @default(0) @map("settlement_seq")

  // The company as it appears on invoices and driver statements. All optional: a sheet prints only what is filled in.
  mcNumber    String? @map("mc_number")
  dotNumber   String? @map("dot_number")
  address     String?
  phone       String?
  email       String?
  /// Where a broker sends the payment (a bank, a factor, a lockbox), printed on the invoice.
  remitTo     String? @map("remit_to")
  paymentNote String? @map("payment_note")

  /// The plan the workspace is on (starter | growth | pro | enterprise). A missing plan is read as Starter (src/lib/plans.ts effectivePlan), never as "no limit".
  plan                String?                @default("starter")
  /// The money-moving switch (docs/MONEY_PLAN.md Gap 14, Wave 7): whether a call to a company may send money for real (factoring submit, payroll send). Off by default; an admin turns it on with a
  /// reason, and it only counts on a server whose operator set MONEY_MOVING_COUNSEL_APPROVED=yes (src/lib/partner-gates.ts). The simulator never needs it.
  moneyMovingLive     Boolean                @default(false) @map("money_moving_live")
  moneyMovingBy       String?                @map("money_moving_by")
  moneyMovingAt       DateTime?              @map("money_moving_at")
  moneyMovingReason   String?                @map("money_moving_reason")
  /// The carrier's own clock (an IANA zone such as America/New_York): where billing days, aging, weekly driver limits, statement weeks and "this month" are counted. Stops keep their own
  /// local time (an appointment at a facility is read in the facility's zone); see src/lib/tz.ts. New workspaces start on Central, as the desk always has.
  timezone            String                 @default("America/Chicago") @map("timezone")
  /// The driver link (docs/DRIVER_LINK_DESIGN.md): the Clerk Organization this workspace is mapped to on the bridge (null = not bridged: the dispatcher records the driver's answers), and the
  /// last `sync_seq` of the bridge table read, so each pull continues where the last one ended.
  bridgeOrgId         String?                @map("bridge_org_id")
  bridgeCursor        BigInt                 @default(0) @map("bridge_cursor")
  partnerConnections  PartnerConnection[]
  bridgeOutbox        BridgeOutbox[]
  partnerCredentials  PartnerCredential[]
  partnerEvents       PartnerEvent[]
  partnerOAuthTokens  PartnerOAuthToken[]
  partnerOAuthStates  PartnerOAuthState[]
  partnerApiKeys      PartnerApiKey[]
  webhookEndpoints    WebhookEndpoint[]
  webhookDeliveries   WebhookDelivery[]
  externalRefs        ExternalRef[]
  syncCursors         SyncCursor[]
  accountingAccounts  AccountingAccount[]
  iftaMileage         IftaMileage[]
  iftaReturns         IftaReturn[]
  iftaRates           IftaRate[]
  fuelTransactions    FuelTransaction[]
  fuelFlagReviews     FuelFlagReview[]
  vehiclePings        VehiclePing[]
  checkCalls          CheckCall[]
  unitStays           UnitStay[]
  trailerMoves        TrailerMove[]
  terminals           Terminal[]
  regions             Region[]
  laneTargets         LaneTarget[]
  kpiNotes            KpiNote[]
  importedHistory     ImportedHistory[]
  signals             Signal[]
  stopEvidence        StopEvidence[]
  notificationLog     NotificationLog[]
  driverSchedules     DriverSchedule[]
  driverTimeOff       DriverShiftException[]
  members             Member[]
  threads             Thread[]
  vehicles            Vehicle[]
  trailers            Trailer[]
  loads               Load[]
  drivers             Driver[]
  auditEvents         AuditEvent[]
  assignmentEvents    AssignmentEvent[]
  loadLegs            LoadLeg[]
  handoffs            Handoff[]
  settlements         Settlement[]
  settlementLines     SettlementLine[]
  driverDeductions    DriverDeduction[]
  driverAdvances      DriverAdvance[]
  driverLedgerEntries DriverLedgerEntry[]
  customers           Customer[]
  invoices            Invoice[]
  factoringTerms      FactoringTerms?
  factoringBatches    FactoringBatch[]
  invoicePayments     InvoicePayment[]

  @@map("workspaces")
}

/// Who a load is for: a broker, a shipper or a direct customer. A load keeps its customer's name as text, so this is the profile attached to that
/// name (kind, MC for a broker or carrier, billing contact, default pay terms, notes) rather than something every load points at.
model Customer {
  id                  String   @id @default(cuid())
  workspaceId         String   @map("workspace_id")
  name                String
  /// broker, shipper or other.
  kind                String   @default("broker")
  mcNumber            String?  @map("mc_number")
  contactName         String?  @map("contact_name")
  contactEmail        String?  @map("contact_email")
  contactPhone        String?  @map("contact_phone")
  /// Used for an invoice to this customer when the load names no terms of its own.
  defaultPayTermsDays Int?     @map("default_pay_terms_days")
  notes               String?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("customers")
}

model Vehicle {
  id                  String    @id @default(cuid())
  workspaceId         String    @map("workspace_id")
  name                String?
  make                String?
  model               String?
  year                Int?
  type                String?
  mpg                 Decimal?  @db.Decimal(8, 3)
  fuelType            String?   @map("fuel_type")
  /// The tractor's fuel tanks, in gallons: a fill bigger than this (plus a little) is flagged on Fuel. Blank until someone types it.
  tankCapacityGallons Decimal?  @map("tank_capacity_gallons") @db.Decimal(8, 1)
  homeBaseAddress     String?   @map("home_base_address")
  /// Where the home base is, found once (permanent geocoding) so measuring a quote does not look the address up each time. Blank until it is found.
  homeBaseLat         Decimal?  @map("home_base_lat") @db.Decimal(9, 6)
  homeBaseLng         Decimal?  @map("home_base_lng") @db.Decimal(9, 6)
  payloadLbs          Int?      @map("payload_lbs")
  maxLengthFt         Decimal?  @map("max_length_ft") @db.Decimal(8, 2)
  maxWidthFt          Decimal?  @map("max_width_ft") @db.Decimal(8, 2)
  maxHeightIn         Decimal?  @map("max_height_in") @db.Decimal(8, 2)
  /// What the truck carries for loads that need it. Unticked reads as "not equipped", as on the phone.
  hasLiftgate         Boolean   @default(false) @map("has_liftgate")
  hasRamp             Boolean   @default(false) @map("has_ramp")
  hasPalletJack       Boolean   @default(false) @map("has_pallet_jack")
  /// Which terminal (yard, branch, region) runs this truck. Free text; the terminals offered are the distinct values in use. Blank = unassigned.
  terminal            String?
  /// The ELD the tractor is linked to and the hours left on the driver's clock as it last reported them (a caution on the Quote, never a rule).
  eldProvider         String    @default("none") @map("eld_provider")
  eldVehicleId        String?   @map("eld_vehicle_id")
  hosAvailableHours   Decimal?  @map("hos_available_hours") @db.Decimal(5, 2)
  hosSyncedAt         DateTime? @map("hos_synced_at")
  /// Where the ELD last put the tractor, and when it said so. Shown as 'last seen'; never an input to a verdict.
  lastLat             Decimal?  @map("last_lat") @db.Decimal(9, 6)
  lastLng             Decimal?  @map("last_lng") @db.Decimal(9, 6)
  lastLocatedAt       DateTime? @map("last_located_at")
  /// What the ELD said about the engine at that fix: speed, heading, moving / idle / off, hours idle today, and when the current idle began. Written only by the ELD sync.
  vin                 String?
  lastSpeedMph        Decimal?  @map("last_speed_mph") @db.Decimal(5, 1)
  lastHeadingDeg      Int?      @map("last_heading_deg")
  engineState         String?   @map("engine_state")
  idleHoursToday      Decimal?  @map("idle_hours_today") @db.Decimal(5, 2)
  idleSince           DateTime? @map("idle_since")
  active              Boolean   @default(true)
  archivedAt          DateTime? @map("archived_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  costProfile      CostProfile?
  loads            Load[]
  drivers          Driver[]
  trailers         Trailer[]
  pings            VehiclePing[]
  stopEvidence     StopEvidence[]
  checkCalls       CheckCall[]
  stays            UnitStay[]
  trailerMoves     TrailerMove[]
  fuelTransactions FuelTransaction[]
  iftaMileage      IftaMileage[]

  @@index([workspaceId, archivedAt, name])
  @@index([workspaceId, terminal])
  @@map("vehicles")
}

/// One per vehicle. Inputs to TrueLane's break-even floor (src/truelane/lib/domain/calculators.ts computeCostProfileFloorBreakdown).
model CostProfile {
  id                               String    @id @default(cuid())
  vehicleId                        String    @unique @map("vehicle_id")
  monthlyInsurance                 Decimal   @default(0) @map("monthly_insurance") @db.Decimal(12, 2)
  monthlyAuthority                 Decimal   @default(0) @map("monthly_authority") @db.Decimal(12, 2)
  monthlyPhoneSubscriptions        Decimal   @default(0) @map("monthly_phone_subscriptions") @db.Decimal(12, 2)
  monthlyLoanPayment               Decimal   @default(0) @map("monthly_loan_payment") @db.Decimal(12, 2)
  estimatedMonthlyMiles            Decimal   @map("estimated_monthly_miles") @db.Decimal(12, 2)
  maintenanceReservePerMile        Decimal   @default(0) @map("maintenance_reserve_per_mile") @db.Decimal(8, 4)
  tireReservePerMile               Decimal   @default(0) @map("tire_reserve_per_mile") @db.Decimal(8, 4)
  driverHourlyTarget               Decimal   @default(0) @map("driver_hourly_target") @db.Decimal(8, 2)
  lastFuelPricePerGallon           Decimal?  @map("last_fuel_price_per_gallon") @db.Decimal(6, 3)
  breakEvenRpm                     Decimal   @map("break_even_rpm") @db.Decimal(8, 4)
  survivalFloorRpm                 Decimal?  @map("survival_floor_rpm") @db.Decimal(8, 4)
  archetype                        String?
  insuranceLiabilityMonthly        Decimal?  @map("insurance_liability_monthly") @db.Decimal(12, 2)
  insurancePhysicalDamageMonthly   Decimal?  @map("insurance_physical_damage_monthly") @db.Decimal(12, 2)
  insuranceCargoMonthly            Decimal?  @map("insurance_cargo_monthly") @db.Decimal(12, 2)
  insuranceGeneralLiabilityMonthly Decimal?  @map("insurance_general_liability_monthly") @db.Decimal(12, 2)
  insuranceOtherMonthly            Decimal?  @map("insurance_other_monthly") @db.Decimal(12, 2)
  otherFixedMonthly                Decimal?  @map("other_fixed_monthly") @db.Decimal(12, 2)
  truckReplacementMonthly          Decimal?  @map("truck_replacement_monthly") @db.Decimal(12, 2)
  annualFixedCosts                 Decimal?  @map("annual_fixed_costs") @db.Decimal(12, 2)
  hiredDriverHourlyRate            Decimal?  @map("hired_driver_hourly_rate") @db.Decimal(8, 2)
  hiredDriverPayKind               String?   @map("hired_driver_pay_kind")
  hiredDriverRatePerMile           Decimal?  @map("hired_driver_rate_per_mile") @db.Decimal(8, 4)
  laborBurdenPct                   Decimal?  @map("labor_burden_pct") @db.Decimal(6, 4)
  carrierCutPct                    Decimal?  @map("carrier_cut_pct") @db.Decimal(6, 4)
  selfEmploymentTaxPct             Decimal?  @map("self_employment_tax_pct") @db.Decimal(6, 4)
  fscCutApplies                    String?   @map("fsc_cut_applies")
  factoringFeePct                  Decimal?  @map("factoring_fee_pct") @db.Decimal(6, 4)
  detentionHourlyRate              Decimal?  @map("detention_hourly_rate") @db.Decimal(8, 2)
  freeGraceMinutes                 Int?      @map("free_grace_minutes")
  dailyRevenueTarget               Decimal?  @map("daily_revenue_target") @db.Decimal(12, 2)
  routeBaseMinimum                 Decimal?  @map("route_base_minimum") @db.Decimal(12, 2)
  routeIncludedMiles               Decimal?  @map("route_included_miles") @db.Decimal(12, 2)
  routeIncludedStops               Int?      @map("route_included_stops")
  routeOveragePerMile              Decimal?  @map("route_overage_per_mile") @db.Decimal(8, 4)
  routeOveragePerStop              Decimal?  @map("route_overage_per_stop") @db.Decimal(8, 2)
  hourlyTargetConfirmedAt          DateTime? @map("hourly_target_confirmed_at")
  createdAt                        DateTime  @default(now()) @map("created_at")
  updatedAt                        DateTime  @updatedAt @map("updated_at")

  vehicle           Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  /// The fuel card a truck buys its fuel on, and the account on it (a partner connection; blank until one is set up).
  fuelCardProvider  String? @map("fuel_card_provider")
  fuelCardAccountId String? @map("fuel_card_account_id")

  @@map("cost_profiles")
}

model Load {
  id                            String    @id @default(cuid())
  workspaceId                   String    @map("workspace_id")
  vehicleId                     String?   @map("vehicle_id")
  channel                       String?
  brokerName                    String?   @map("broker_name")
  brokerMcNumber                String?   @map("broker_mc_number")
  originAddress                 String?   @map("origin_address")
  destinationAddress            String?   @map("destination_address")
  loadType                      String?   @map("load_type")
  trailerType                   String?   @map("trailer_type")
  pickupDeadheadMiles           Decimal   @default(0) @map("pickup_deadhead_miles") @db.Decimal(12, 4)
  loadedMiles                   Decimal   @default(0) @map("loaded_miles") @db.Decimal(12, 4)
  returnDeadheadMiles           Decimal   @default(0) @map("return_deadhead_miles") @db.Decimal(12, 4)
  quotedRevenue                 Decimal   @default(0) @map("quoted_revenue") @db.Decimal(12, 2)
  actualRevenue                 Decimal?  @map("actual_revenue") @db.Decimal(12, 2)
  fuelSurcharge                 Decimal?  @map("fuel_surcharge") @db.Decimal(12, 2)
  fuelSurchargeUnit             String?   @map("fuel_surcharge_unit")
  layoverPay                    Decimal?  @map("layover_pay") @db.Decimal(12, 2)
  tonuRevenue                   Decimal?  @map("tonu_revenue") @db.Decimal(12, 2)
  expenseFuelActual             Decimal   @default(0) @map("expense_fuel_actual") @db.Decimal(12, 2)
  expenseTolls                  Decimal   @default(0) @map("expense_tolls") @db.Decimal(12, 2)
  expenseMisc                   Decimal   @default(0) @map("expense_misc") @db.Decimal(12, 2)
  status                        String    @default("draft")
  scheduledDate                 DateTime? @map("scheduled_date")
  completedAt                   DateTime? @map("completed_at")
  cancelledAt                   DateTime? @map("cancelled_at")
  cancelReason                  String?   @map("cancel_reason")
  paymentTerms                  String?   @map("payment_terms")
  payTermsDays                  Int?      @map("pay_terms_days")
  isBackhaul                    Boolean   @default(false) @map("is_backhaul")
  stopsCount                    Int?      @map("stops_count")
  dockWaitMinutes               Int?      @map("dock_wait_minutes")
  /// Drive time for the loaded miles as measured on the road when the load was quoted. Blank means the desk assumes 50 mph over every mile.
  estimatedLoadedHours          Decimal?  @map("estimated_loaded_hours") @db.Decimal(8, 2)
  /// What a saved quote keeps that a load has no column for: the fuel price and where it came from, each truck's measured or typed empty miles, which figures were typed by hand, and the driver picked.
  quoteExtras                   Json?     @map("quote_extras")
  factoringFeePct               Decimal?  @map("factoring_fee_pct") @db.Decimal(6, 4)
  insuranceRiderFlat            Decimal?  @map("insurance_rider_flat") @db.Decimal(12, 2)
  marketBenchmark               Decimal?  @map("market_benchmark") @db.Decimal(12, 4)
  quotedPickupDhMiles           Decimal?  @map("quoted_pickup_dh_miles") @db.Decimal(12, 4)
  quotedLoadedMiles             Decimal?  @map("quoted_loaded_miles") @db.Decimal(12, 4)
  quotedReturnDhMiles           Decimal?  @map("quoted_return_dh_miles") @db.Decimal(12, 4)
  loadNumber                    String?   @map("load_number")
  poNumber                      String?   @map("po_number")
  pickupNumbers                 Json?     @map("pickup_numbers")
  deliveryNumbers               Json?     @map("delivery_numbers")
  weightLbs                     Int?      @map("weight_lbs")
  lengthFt                      Decimal?  @map("length_ft") @db.Decimal(8, 2)
  widthFt                       Decimal?  @map("width_ft") @db.Decimal(8, 2)
  loadHeightIn                  Decimal?  @map("load_height_in") @db.Decimal(8, 2)
  hazmatClass                   String?   @map("hazmat_class")
  requiresLiftgate              Boolean?  @map("requires_liftgate")
  requiresRamp                  Boolean?  @map("requires_ramp")
  requiresPalletJack            Boolean?  @map("requires_pallet_jack")
  brokerPhone                   String?   @map("broker_phone")
  brokerEmail                   String?   @map("broker_email")
  notes                         String?
  /// What the proof of delivery is, or why there is none (closedWithoutPod). The file itself waits for the phone's storage.
  podNote                       String?   @map("pod_note")
  /// The invoice as billed, one entry per line: [{ label, amount }]. Its total is invoicedAmount.
  invoiceLines                  Json?     @map("invoice_lines")
  rateConPath                   String?   @map("rate_con_path")
  closedWithoutPod              Boolean?  @map("closed_without_pod")
  invoiceNumber                 String?   @map("invoice_number")
  invoicedAmount                Decimal?  @map("invoiced_amount") @db.Decimal(12, 2)
  paymentStatus                 String?   @map("payment_status")
  invoicedAt                    DateTime? @map("invoiced_at")
  paidAt                        DateTime? @map("paid_at")
  paidAmount                    Decimal?  @map("paid_amount") @db.Decimal(12, 2)
  /// What was written off when an invoice was closed short, and why: the money billed that will never come in, kept where revenue and cash can be reconciled.
  writeOffAmount                Decimal?  @map("write_off_amount") @db.Decimal(12, 2)
  writeOffReason                String?   @map("write_off_reason")
  /// What the trip cost, itemised: {lumper, scale, parking, lodging, wash, maintenance, permits, supplies}. expenseMisc stays the total of these and "other", so every sum that reads it is unchanged.
  expenseItems                  Json?     @map("expense_items")
  /// Why the revenue is what it is (a short pay, a detention the broker agreed to), in the dispatcher's words.
  revenueNote                   String?   @map("revenue_note")
  /// What the dispatcher wrote when the load was cancelled or turned into a TONU.
  cancelNote                    String?   @map("cancel_note")
  /// Miles driven on a load that became a TONU (the truck went and the load was not ready).
  tonuMiles                     Decimal?  @map("tonu_miles") @db.Decimal(12, 4)
  /// How the payment came in: ach, check, wire, card, factoring or other.
  paidMethod                    String?   @map("paid_method")
  // Cost snapshot frozen at accept (TrueLane v46-v48), so a later profile edit never rewrites a finished load.
  snapshotBaseFloorRpm          Decimal?  @map("snapshot_base_floor_rpm") @db.Decimal(8, 4)
  snapshotTotalInsuranceMonthly Decimal?  @map("snapshot_total_insurance_monthly") @db.Decimal(12, 2)
  snapshotEstimatedMonthlyMiles Decimal?  @map("snapshot_estimated_monthly_miles") @db.Decimal(12, 2)
  snapshotArchetype             String?   @map("snapshot_archetype")
  snapshotCarrierCutPct         Decimal?  @map("snapshot_carrier_cut_pct") @db.Decimal(6, 4)
  snapshotLaborCpm              Decimal?  @map("snapshot_labor_cpm") @db.Decimal(8, 4)
  snapshotMpg                   Decimal?  @map("snapshot_mpg") @db.Decimal(8, 3)
  snapshotFscCutApplies         Boolean?  @map("snapshot_fsc_cut_applies")
  snapshotDetentionRate         Decimal?  @map("snapshot_detention_rate") @db.Decimal(8, 2)
  snapshotFreeGraceMinutes      Int?      @map("snapshot_free_grace_minutes")
  createdAt                     DateTime  @default(now()) @map("created_at")
  updatedAt                     DateTime  @updatedAt @map("updated_at")
  deletedAt                     DateTime? @map("deleted_at")
  /// The trailer unit pulling this load (a record in the trailer registry). `trailerType` stays the kind of equipment the load needs.
  trailerId                     String?   @map("trailer_id")
  /// Where the invoice stands with a factor: none | requested | submitted | funded | rejected | paid.
  factoringStatus               String    @default("none") @map("factoring_status")
  factoringReferenceId          String?   @map("factoring_reference_id")
  factoringUpdatedAt            DateTime? @map("factoring_updated_at")
  /// Location sharing with a tracking network, for this load only (the carrier's yes each time): the link a customer follows, who it is with, and when it began. Cleared when sharing stops.
  trackingShareUrl              String?   @map("tracking_share_url")
  trackingProvider              String?   @map("tracking_provider")
  trackingSharedAt              DateTime? @map("tracking_shared_at")

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  vehicle          Vehicle?          @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  trailer          Trailer?          @relation(fields: [trailerId], references: [id], onDelete: SetNull)
  stops            Stop[]
  documents        LoadDocument[]
  fuelTransactions FuelTransaction[]
  payments         LoadPayment[]
  segments         TripSegment[]
  decisions        LoadDecision[]
  checkCalls       CheckCall[]
  assignment       Assignment?
  legs             LoadLeg[]
  handoffs         Handoff[]
  messages         Message[]
  settlement       SettlementLoad?
  signals          Signal[]
  stopEvidence     StopEvidence[]
  invoiceLoads     InvoiceLoad[]
  invoiceLineRows  InvoiceLine[]
  iftaMileage      IftaMileage[]

  // The lists a big fleet reads: by state, by day, by money, by customer, by number, and a truck's own loads. Trigram (search) indexes are in the
  // 20261106100000 migration only; Prisma cannot express them.
  @@index([workspaceId, deletedAt, status])
  @@index([workspaceId, scheduledDate])
  @@index([workspaceId, completedAt])
  @@index([workspaceId, paymentStatus])
  @@index([workspaceId, paymentStatus, invoicedAt])
  @@index([workspaceId, brokerName])
  @@index([workspaceId, loadNumber])
  @@index([vehicleId, status])
  @@index([trailerId])
  @@map("loads")
}

model Stop {
  id                 String    @id @default(cuid())
  loadId             String    @map("load_id")
  stopSequence       Int       @map("stop_sequence")
  addressString      String    @map("address_string")
  lat                Decimal?  @db.Decimal(9, 6)
  lng                Decimal?  @db.Decimal(9, 6)
  stopType           String    @map("stop_type")
  stopRole           String?   @map("stop_role")
  referenceNumbers   Json?     @map("reference_numbers")
  timeWindowEarliest DateTime? @map("time_window_earliest")
  timeWindowLatest   DateTime? @map("time_window_latest")
  podPhotoUrl        String?   @map("pod_photo_url")
  facilityName       String?   @map("facility_name")
  contactName        String?   @map("contact_name")
  contactPhone       String?   @map("contact_phone")
  stopNotes          String?   @map("stop_notes")
  waitMinutes        Int?      @map("wait_minutes")
  arrivedAt          DateTime? @map("arrived_at")
  sealNumber         String?   @map("seal_number")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  load     Load          @relation(fields: [loadId], references: [id], onDelete: Cascade)
  evidence StopEvidence?

  @@index([loadId, stopSequence])
  @@map("stops")
}

model TripSegment {
  id               String    @id @default(cuid())
  loadId           String    @map("load_id")
  segmentType      String    @map("segment_type")
  miles            Decimal   @db.Decimal(12, 4)
  durationMinutes  Int?      @map("duration_minutes")
  fuelCost         Decimal?  @map("fuel_cost") @db.Decimal(12, 2)
  isManualOverride Boolean   @default(false) @map("is_manual_override")
  startedAt        DateTime? @map("started_at")
  endedAt          DateTime? @map("ended_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  load Load @relation(fields: [loadId], references: [id], onDelete: Cascade)

  @@index([loadId])
  @@map("trip_segments")
}

model LoadDecision {
  id             String   @id @default(cuid())
  loadId         String   @map("load_id")
  decisionType   String   @map("decision_type")
  overrideReason String?  @map("override_reason")
  overrideNotes  String?  @map("override_notes")
  /// What the decision was made on, for the Quote decisions report: the verdict, what it was read against, the money, the first offer, the truck and the fuel price. Blank on decisions made before it was kept.
  details        Json?
  /// Who decided (the signed-in person, or "Dispatcher" with sign-in off).
  decidedBy      String?  @map("decided_by")
  decidedAt      DateTime @map("decided_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  load Load @relation(fields: [loadId], references: [id], onDelete: Cascade)

  @@index([loadId])
  @@map("load_decisions")
}

// ── Dispatcher layer (desktop-owned) ─────────────────────────────────────────────────────────

/// A driver the dispatcher can assign. TrueLane keeps its `drivers` table on the phone only.
model Driver {
  id                 String    @id @default(cuid())
  workspaceId        String    @map("workspace_id")
  name               String
  phone              String?
  email              String?
  cdlClass           String?   @map("cdl_class")
  cdlExpiry          DateTime? @map("cdl_expiry")
  medicalCardExpiry  DateTime? @map("medical_card_expiry")
  assignedVehicleId  String?   @map("assigned_vehicle_id")
  /// What this driver is usually paid: cpm | hourly | flat, and the rate. An assignment starts from it; the assignment's own pay wins.
  defaultPayKind     String?   @map("default_pay_kind")
  defaultPayRate     Decimal?  @map("default_pay_rate") @db.Decimal(12, 4)
  /// Which terminal (yard, branch, region) this driver works out of; the same free-text values as a truck's. Blank = unassigned.
  terminal           String?
  /// Payroll: the id the payroll company knows them by, whether they are an employee or a contractor, and whether they have been set up there (none | ready | sent | failed).
  payrollEmployeeId  String?   @map("payroll_employee_id")
  payrollStatus      String    @default("none") @map("payroll_status")
  payrollWorkerType  String?   @map("payroll_worker_type")
  /// The 1099 tax profile: the legal name, ssn | ein, its last four digits only (the full number lives with the payroll company and is never stored here; a database check refuses more than four digits), none | collected | verified, and the mailing address.
  legalName          String?   @map("legal_name")
  tinType            String?   @map("tin_type")
  tinLast4           String?   @map("tin_last4")
  tinStatus          String    @default("none") @map("tin_status")
  taxAddressLine1    String?   @map("tax_address_line1")
  taxAddressLine2    String?   @map("tax_address_line2")
  taxCity            String?   @map("tax_city")
  taxState           String?   @map("tax_state")
  taxZip             String?   @map("tax_zip")
  /// The driver's own phone account (their Clerk user id on the bridge). Blank = no phone account: the dispatcher records their answers.
  phoneUserId        String?   @map("phone_user_id")
  /// The driver's id in the ELD, and the minutes left on each clock as it last reported them (drive, shift, 70-hour cycle). A caution, never a rule.
  eldDriverId        String?   @map("eld_driver_id")
  licenseNumber      String?   @map("license_number")
  hosDriveMinutes    Int?      @map("hos_drive_minutes")
  hosShiftMinutes    Int?      @map("hos_shift_minutes")
  hosCycleMinutes    Int?      @map("hos_cycle_minutes")
  hosSyncedAt        DateTime? @map("hos_synced_at")
  /// The carrier authority the driver (or their company) runs under, and what the last insurance check found.
  carrierMcNumber    String?   @map("carrier_mc_number")
  carrierDotNumber   String?   @map("carrier_dot_number")
  vetStatus          String    @default("unchecked") @map("vet_status")
  coiExpiresAt       DateTime? @map("coi_expires_at")
  vetCheckedAt       DateTime? @map("vet_checked_at")
  /// What the carrier check said besides its three words: the safety score (0 to 100), whether the operating authority is active, and the reasons it gave.
  vetSafetyScore     Int?      @map("vet_safety_score")
  vetAuthorityActive Boolean?  @map("vet_authority_active")
  vetFlags           Json?     @map("vet_flags")
  /// The driver's short code: first initial plus the first three letters of the last name (JSMI), a number on the end for a second driver who comes to the same one (JSMI2). Made once, never follows a rename.
  code               String?
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  workspace       Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignedVehicle Vehicle?               @relation(fields: [assignedVehicleId], references: [id], onDelete: SetNull)
  assignments     Assignment[]
  thread          Thread?
  settlements     Settlement[]
  schedule        DriverSchedule?
  deductions      DriverDeduction[]
  advances        DriverAdvance[]
  ledger          DriverLedgerEntry[]
  timeOff         DriverShiftException[]

  @@unique([workspaceId, phoneUserId])
  @@unique([workspaceId, code])
  @@index([workspaceId, active, name])
  @@index([workspaceId, terminal])
  @@index([assignedVehicleId])
  @@map("drivers")
}

/// One driver and one pay per dispatched load (CONVERGENCE_BUILD_PLAN section 6). The pay shape is the bridge
/// contract's driver_pay: { kind: flat | cpm | hourly, rate }; `estimate` is display only.
/// status: draft | dispatched | accepted | declined | in_progress | completed.
model Assignment {
  id                     String    @id @default(cuid())
  loadId                 String    @unique @map("load_id")
  driverId               String    @map("driver_id")
  payKind                String    @map("pay_kind")
  payRate                Decimal   @map("pay_rate") @db.Decimal(12, 4)
  payEstimate            Decimal?  @map("pay_estimate") @db.Decimal(12, 2)
  status                 String    @default("draft")
  assignmentVersion      Int       @default(1) @map("assignment_version")
  driverResponse         Json?     @map("driver_response")
  dispatchedAt           DateTime? @map("dispatched_at")
  respondedAt            DateTime? @map("responded_at")
  /// The driver link: the bridge row this assignment is on, the last execution version of it the desk applied, when it last went through, and why a delivery failed (a word, never a body).
  bridgeDispatchId       String?   @map("bridge_dispatch_id")
  bridgeExecutionVersion Int       @default(0) @map("bridge_execution_version")
  bridgeSyncedAt         DateTime? @map("bridge_synced_at")
  bridgeError            String?   @map("bridge_error")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  load   Load   @relation(fields: [loadId], references: [id], onDelete: Cascade)
  driver Driver @relation(fields: [driverId], references: [id], onDelete: Restrict)

  @@index([driverId, status])
  @@index([status])
  @@map("assignments")
}

/// Who held a load, when, and why it changed hands (docs/RELAY_DESIGN.md). One row per move of the assignment: assigned, reassigned, sent, accepted, declined, recalled.
/// The audit trail says it in words; this says it in fields, so "who had this load" and "which loads were recalled, and why" are queries, not text searches.
/// `loadId` is a plain column (no foreign key) and `loadNumber` and `driverName` are copied in, so the trail outlives a deleted load or driver.
/// reasonCode is set on a recall (ASSIGNED_IN_ERROR | HOS_TIMEOUT | MECHANICAL_BREAKDOWN | DRIVER_UNRESPONSIVE | SCHEDULED_RELAY).
model AssignmentEvent {
  id                String   @id @default(cuid())
  workspaceId       String   @map("workspace_id")
  loadId            String   @map("load_id")
  loadNumber        String?  @map("load_number")
  /// assigned | reassigned | sent | accepted | declined | recalled | removed (taken off before it was ever sent) | dropped (handed off at a relay point) | received (took custody at a relay point)
  kind              String
  driverId          String?  @map("driver_id")
  driverName        String?  @map("driver_name")
  reasonCode        String?  @map("reason_code")
  reasonNote        String?  @map("reason_note")
  actor             String   @default("Dispatcher")
  /// dispatcher | phone
  via               String   @default("dispatcher")
  assignmentVersion Int?     @map("assignment_version")
  createdAt         DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([loadId, createdAt])
  @@index([workspaceId, kind, createdAt])
  @@map("assignment_events")
}

/// One custody span of a load: a driver and truck (and trailer) from one point to another (docs/RELAY_DESIGN.md). A load with no relay has no legs written: it is one implicit leg, the assignment.
/// The first handoff or an empty recall writes leg 1 from the assignment as it was, so each leg keeps who drove it, in what, over what miles, and the pay as it stood when the leg closed.
/// kind: haul | positioning (a driver recalled while rolling empty to the pickup: no freight, paid for the miles). status: active | closed. milesSource: eld | driver | dispatcher (never a guess).
model LoadLeg {
  id            String    @id @default(cuid())
  workspaceId   String    @map("workspace_id")
  loadId        String    @map("load_id")
  seq           Int
  kind          String    @default("haul")
  status        String    @default("active")
  driverId      String?   @map("driver_id")
  driverName    String?   @map("driver_name")
  vehicleId     String?   @map("vehicle_id")
  vehicleName   String?   @map("vehicle_name")
  trailerId     String?   @map("trailer_id")
  trailerNumber String?   @map("trailer_number")
  fromName      String?   @map("from_name")
  fromLat       Decimal?  @map("from_lat") @db.Decimal(9, 6)
  fromLng       Decimal?  @map("from_lng") @db.Decimal(9, 6)
  toName        String?   @map("to_name")
  toLat         Decimal?  @map("to_lat") @db.Decimal(9, 6)
  toLng         Decimal?  @map("to_lng") @db.Decimal(9, 6)
  startedAt     DateTime? @map("started_at")
  endedAt       DateTime? @map("ended_at")
  milesDriven   Decimal?  @map("miles_driven") @db.Decimal(10, 1)
  milesSource   String?   @map("miles_source")
  /// The pay as it stood when the leg closed (a copy of the assignment's), so a later leg does not overwrite it. Settlement reads it in phase 3.
  payKind       String?   @map("pay_kind")
  payRate       Decimal?  @map("pay_rate") @db.Decimal(12, 4)
  payEstimate   Decimal?  @map("pay_estimate") @db.Decimal(12, 2)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  load      Load      @relation(fields: [loadId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([loadId, seq])
  @@index([workspaceId, loadId])
  @@map("load_legs")
}

/// The baton: the record that closes one leg and opens the next (docs/RELAY_DESIGN.md, BATON_CONTRACT_V3.md). One row per handoff.
/// type: drop_hook | rescue | slip_seat. reason: planned | hos | breakdown | recall_convert. state: dropped | received | disputed.
/// Every value that came from a person names its source (droppedSource / receivedSource: driver | dispatcher | eld) and who entered it; a value nobody gave stays null. No money lives here.
/// A discrepancy freezes the baton (frozenAt, frozenSha256) and blocks custody until dispatch acknowledges it. Photos and documents arrive with the phone (phase 4).
model Handoff {
  id                 String    @id @default(cuid())
  workspaceId        String    @map("workspace_id")
  loadId             String    @map("load_id")
  type               String
  reason             String
  state              String    @default("dropped")
  outLegSeq          Int       @map("out_leg_seq")
  inLegSeq           Int?      @map("in_leg_seq")
  locationName       String?   @map("location_name")
  locationLat        Decimal?  @map("location_lat") @db.Decimal(9, 6)
  locationLng        Decimal?  @map("location_lng") @db.Decimal(9, 6)
  locationSlot       String?   @map("location_slot")
  /// planned_yard | emergency_pin | dispatcher_typed
  locationSetBy      String    @default("dispatcher_typed") @map("location_set_by")
  tractorOutId       String?   @map("tractor_out_id")
  tractorOutName     String?   @map("tractor_out_name")
  tractorInId        String?   @map("tractor_in_id")
  tractorInName      String?   @map("tractor_in_name")
  trailerId          String?   @map("trailer_id")
  trailerNumber      String?   @map("trailer_number")
  outDriverId        String?   @map("out_driver_id")
  outDriverName      String?   @map("out_driver_name")
  inDriverId         String?   @map("in_driver_id")
  inDriverName       String?   @map("in_driver_name")
  sealNumber         String?   @map("seal_number")
  /// On the pickup side: whether the seal matched what the outgoing driver recorded. Null until the incoming driver says.
  sealMatches        Boolean?  @map("seal_matches")
  reeferSetTemp      Decimal?  @map("reefer_set_temp") @db.Decimal(6, 1)
  reeferActualTemp   Decimal?  @map("reefer_actual_temp") @db.Decimal(6, 1)
  reeferFuelPct      Int?      @map("reefer_fuel_pct")
  conditionOk        Boolean?  @map("condition_ok")
  conditionNotes     String?   @map("condition_notes")
  discrepancyFlagged Boolean   @default(false) @map("discrepancy_flagged")
  discrepancyNotes   String?   @map("discrepancy_notes")
  discrepancyBy      String?   @map("discrepancy_by")
  discrepancyAt      DateTime? @map("discrepancy_at")
  ackBy              String?   @map("ack_by")
  ackAt              DateTime? @map("ack_at")
  /// What the outgoing driver does now: bobtail | hook_empty | return_load | available_at_yard
  outgoingNext       String?   @map("outgoing_next")
  droppedAt          DateTime  @map("dropped_at")
  droppedSource      String    @default("dispatcher") @map("dropped_source")
  receivedAt         DateTime? @map("received_at")
  receivedSource     String?   @map("received_source")
  enteredBy          String    @default("Dispatcher") @map("entered_by")
  via                String    @default("dispatcher")
  frozenAt           DateTime? @map("frozen_at")
  frozenSha256       String?   @map("frozen_sha256")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  load      Load      @relation(fields: [loadId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([loadId, createdAt])
  @@index([workspaceId, state])
  @@map("handoffs")
}

/// What the desk did and why: assignments, sends, driver answers, unassignments, invoices, payments and rate-confirmation
/// saves. `loadId` is a plain column (no foreign key) and `loadNumber` is copied in, so the trail outlives a deleted load.
/// `before` / `after` are small label-to-value objects shown as a diff; `reason` is the dispatcher's own words.
model AuditEvent {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  loadId      String?  @map("load_id")
  loadNumber  String?  @map("load_number")
  entity      String
  /// The record the event is about (a trailer's id), so a record's history is found by id and not by matching words. Older events leave it blank.
  entityId    String?  @map("entity_id")
  action      String
  summary     String
  reason      String?
  before      Json?
  after       Json?
  actor       String   @default("Dispatcher")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, action, createdAt])
  @@index([entityId, createdAt])
  @@index([loadId, createdAt])
  @@map("audit_events")
}

/// A driver's pay statement for a period. A draft lists the driver's delivered loads in the period (worked out from the loads each time it is
/// shown) with typed hours for hourly pay and typed adjustments; finalizing freezes the load lines, the adjustments and the total, and ties each
/// load to the statement so it cannot be paid twice. Voiding a final statement releases its loads and keeps the statement as it was.
/// status: draft | final | void. The period is two Dallas calendar dates.
model Settlement {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  driverId    String    @map("driver_id")
  number      String
  status      String    @default("draft")
  periodStart DateTime  @map("period_start") @db.Date
  periodEnd   DateTime  @map("period_end") @db.Date
  /// Draft only: the hours typed for hourly loads, by load id.
  hours       Json?
  /// Typed lines other than loads, [{ label, amount }] with the amount signed (a deduction is negative).
  adjustments Json?
  /// Final or void: the load lines as they were when it was finalized.
  lines       Json?
  total       Decimal?  @db.Decimal(12, 2)
  finalizedAt DateTime? @map("finalized_at")
  voidedAt    DateTime? @map("voided_at")
  voidReason  String?   @map("void_reason")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace           Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  driver              Driver              @relation(fields: [driverId], references: [id], onDelete: Restrict)
  loads               SettlementLoad[]
  lineRows            SettlementLine[]
  /// When the statement was sent to payroll, and the reference payroll gave it. Blank until sent.
  /// Fuel card purchases deducted on this statement: the ids picked while it is a draft, and the ledger as it was when it was finalized.
  fuelIds             Json?               @map("fuel_ids")
  fuel                Json?
  fuelTransactions    FuelTransaction[]
  payrollSentAt       DateTime?           @map("payroll_sent_at")
  payrollReference    String?             @map("payroll_reference")
  /// When the driver was paid, and how, when it was not through payroll (a check, a transfer). A statement paid either way cannot be voided.
  paidAt              DateTime?           @map("paid_at")
  paidMethod          String?             @map("paid_method")
  /// Payroll status poll (Wave 4 step 5): when the desk last asked about this run, and, when payroll refused the payment, when and why (the statement is released to be sent again).
  payrollCheckedAt    DateTime?           @map("payroll_checked_at")
  payrollRejectedAt   DateTime?           @map("payroll_rejected_at")
  payrollRejectReason String?             @map("payroll_reject_reason")
  /// Draft only: the deductions skipped on this statement (with the reason) and an escrow release (with the reason). Wave 4 step 3.
  deductionChoices    Json?               @map("deduction_choices")
  ledger              DriverLedgerEntry[]

  @@unique([workspaceId, number])
  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, finalizedAt])
  @@index([driverId])
  @@index([status, payrollSentAt])
  @@map("settlements")
}

/// A load paid on a final statement. One row per load at most, which is what stops a load being paid twice; voiding the statement deletes its rows.
model SettlementLoad {
  id           String  @id @default(cuid())
  settlementId String  @map("settlement_id")
  loadId       String  @unique @map("load_id")
  amount       Decimal @db.Decimal(12, 2)

  settlement Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  load       Load       @relation(fields: [loadId], references: [id], onDelete: Restrict)

  @@index([settlementId])
  @@map("settlement_loads")
}

/// One line of a final (or voided) driver statement, frozen at finalize (docs/MONEY_PLAN.md, Wave 4 step 1, rule J): a load's pay, a fuel card purchase taken off, or a typed
/// adjustment. Signed: pay is positive, money off is negative, and a statement's rows add up to its total to the cent. Written in the same transaction as the statement's JSON,
/// which stays as a projection until every reader moves. Voiding keeps the rows: the statement stays on record.
/// kind: load | fuel | adjustment (later: deduction | advance | advance_repaid | escrow | escrow_release).
model SettlementLine {
  id                String    @id @default(cuid())
  workspaceId       String    @map("workspace_id")
  settlementId      String    @map("settlement_id")
  sort              Int
  kind              String
  label             String
  basis             String?
  amount            Decimal   @db.Decimal(12, 2)
  loadId            String?   @map("load_id")
  loadNumber        String?   @map("load_number")
  deliveredAt       DateTime? @map("delivered_at")
  payKind           String?   @map("pay_kind")
  payRate           Decimal?  @map("pay_rate") @db.Decimal(12, 4)
  hours             Decimal?  @db.Decimal(8, 2)
  fuelTransactionId String?   @map("fuel_transaction_id")
  gallons           Decimal?  @db.Decimal(10, 3)
  /// The recurring deduction a deduction or escrow row came from.
  deductionId       String?   @map("deduction_id")
  /// The advance a repayment row came from.
  advanceId         String?   @map("advance_id")
  createdAt         DateTime  @default(now()) @map("created_at")

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  settlement Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@unique([settlementId, sort])
  @@index([workspaceId, kind])
  @@index([loadId])
  @@map("settlement_lines")
}

/// A recurring deduction on a contractor's statements (docs/MONEY_PLAN.md, Wave 4 step 3): lease, insurance, ELD, escrow or other, an amount per statement, an optional goal (escrow: the balance
/// to hold) or cap (the rest: the most to take in all), and the dates it runs. A draft proposes it; the dispatcher can skip it for one statement with a reason. Rule K.
model DriverDeduction {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  driverId    String    @map("driver_id")
  kind        String
  label       String
  amount      Decimal   @db.Decimal(12, 2)
  goal        Decimal?  @db.Decimal(12, 2)
  startsOn    DateTime? @map("starts_on") @db.Date
  endsOn      DateTime? @map("ends_on") @db.Date
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  driver    Driver              @relation(fields: [driverId], references: [id], onDelete: Cascade)
  entries   DriverLedgerEntry[]

  @@index([workspaceId, driverId, active])
  @@map("driver_deductions")
}

/// One driver's ledger: what was taken (deduction), what is held for them (escrow) and what was paid back from escrow (escrow_release), signed as on the statement. Written when a statement is
/// finalized, removed when it is voided. Escrow is the driver's money, never income.
model DriverLedgerEntry {
  id           String   @id @default(cuid())
  workspaceId  String   @map("workspace_id")
  driverId     String   @map("driver_id")
  deductionId  String?  @map("deduction_id")
  advanceId    String?  @map("advance_id")
  settlementId String?  @map("settlement_id")
  kind         String
  label        String
  amount       Decimal  @db.Decimal(12, 2)
  reason       String?
  createdAt    DateTime @default(now()) @map("created_at")

  workspace  Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  driver     Driver           @relation(fields: [driverId], references: [id], onDelete: Restrict)
  deduction  DriverDeduction? @relation(fields: [deductionId], references: [id], onDelete: Restrict)
  advance    DriverAdvance?   @relation(fields: [advanceId], references: [id], onDelete: Restrict)
  settlement Settlement?      @relation(fields: [settlementId], references: [id], onDelete: Restrict)

  @@index([workspaceId, driverId])
  @@index([deductionId])
  @@index([settlementId])
  @@index([advanceId])
  @@map("driver_ledger_entries")
}

/// Money given to a contractor ahead of their pay (docs/MONEY_PLAN.md, Wave 4 step 4): the amount, the day, how (cash | check | transfer | fuel_card | other), and the set amount each statement
/// repays until it is cleared. What is owed is the sum of its ledger entries (the advance, then each repayment), never below zero. Repayment is a proposed line like a deduction.
model DriverAdvance {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  driverId    String   @map("driver_id")
  amount      Decimal  @db.Decimal(12, 2)
  givenOn     DateTime @map("given_on") @db.Date
  method      String
  repayAmount Decimal  @map("repay_amount") @db.Decimal(12, 2)
  note        String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  driver    Driver              @relation(fields: [driverId], references: [id], onDelete: Cascade)
  entries   DriverLedgerEntry[]

  @@index([workspaceId, driverId, active])
  @@map("driver_advances")
}

/// A trailer unit in the registry: owned, leased, a customer's or a pool trailer. Desk-only (the phone has no trailer record). It is hooked to at most one
/// tractor at a time (a partial unique index) and can be put on a load; its registration and inspection dates feed the same alerts a driver's cards do.
/// status: available | in_shop | out_of_service. "On a load" is read from the open loads, not stored.
model Trailer {
  id                 String    @id @default(cuid())
  workspaceId        String    @map("workspace_id")
  number             String
  type               String?
  plate              String?
  plateState         String?   @map("plate_state")
  vin                String?
  ownership          String    @default("owned")
  lengthFt           Decimal?  @map("length_ft") @db.Decimal(8, 2)
  widthIn            Decimal?  @map("width_in") @db.Decimal(8, 2)
  tareLbs            Int?      @map("tare_lbs")
  maxPayloadLbs      Int?      @map("max_payload_lbs")
  axles              Int?
  hasLiftgate        Boolean   @default(false) @map("has_liftgate")
  hasETrack          Boolean   @default(false) @map("has_e_track")
  status             String    @default("available")
  terminal           String?
  location           String?
  currentVehicleId   String?   @map("current_vehicle_id")
  /// Where the trailer is: with its tractor while hooked, where it was dropped once unhooked. `unhookedAt` starts the dwell clock; cleared when it is hooked again.
  lastLat            Decimal?  @map("last_lat") @db.Decimal(9, 6)
  lastLng            Decimal?  @map("last_lng") @db.Decimal(9, 6)
  lastLocatedAt      DateTime? @map("last_located_at")
  hookedAt           DateTime? @map("hooked_at")
  unhookedAt         DateTime? @map("unhooked_at")
  /// A person's own dwell figure for this stay, which always beats the company's: a rate a day, the billable days, or the whole fee waived. Cleared when the trailer is hooked again.
  dwellRateOverride  Decimal?  @map("dwell_rate_override") @db.Decimal(8, 2)
  dwellDaysOverride  Decimal?  @map("dwell_days_override") @db.Decimal(6, 2)
  dwellWaived        Boolean   @default(false) @map("dwell_waived")
  dwellOverrideNote  String?   @map("dwell_override_note")
  dwellOverrideBy    String?   @map("dwell_override_by")
  dwellOverrideAt    DateTime? @map("dwell_override_at")
  registrationExpiry DateTime? @map("registration_expiry")
  inspectionExpiry   DateTime? @map("inspection_expiry")
  notes              String?
  archivedAt         DateTime? @map("archived_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  currentVehicle Vehicle?      @relation(fields: [currentVehicleId], references: [id], onDelete: SetNull)
  loads          Load[]
  checkCalls     CheckCall[]
  moves          TrailerMove[]

  @@index([workspaceId, archivedAt, number])
  @@index([workspaceId, terminal])
  @@index([workspaceId, status])
  @@index([currentVehicleId])
  @@map("trailers")
}

/// Which company a workspace has connected for a capability (factoring, eld, fuel_card, tracking, vetting, payroll, ifta). No credential is stored here:
/// the company's keys are server secrets, and this row only says the connection was made and its state.
model PartnerConnection {
  id           String    @id @default(cuid())
  workspaceId  String    @map("workspace_id")
  capability   String
  provider     String
  status       String    @default("connected")
  accountLabel String?   @map("account_label")
  lastError    String?   @map("last_error")
  connectedAt  DateTime? @map("connected_at")
  /// Health: when the company last answered, how many calls in a row have failed, and when the schedule next asks (docs/PARTNER_BACKBONE.md).
  lastSyncedAt DateTime? @map("last_synced_at")
  failures     Int       @default(0)
  nextSyncAt   DateTime? @map("next_sync_at")
  /// The unguessable part of this connection's webhook address: the company posts to /partners/webhook/<provider>/<token>, which finds the fleet without trusting the body.
  webhookToken String?   @unique @map("webhook_token")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, capability, provider])
  @@map("partner_connections")
}

/// A fleet's own keys for a partner company, encrypted at rest (AES-256-GCM, a server key outside the database). Only `hints` (the last four characters of each field) ever leave the server.
model PartnerCredential {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  provider    String
  /// "v1.<iv>.<tag>.<ciphertext>" of a JSON object of secret name to value. Never returned by any query the screens use.
  sealed      String
  /// Secret name to "...abcd": what the screen may show.
  hints       Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
  @@map("partner_credentials")
}

/// A fleet's sign-in to a partner company that connects by OAuth 2 (QuickBooks Online first; docs/MONEY_PLAN.md, Wave 3), beside the pasted keys in PartnerCredential. The access and refresh
/// tokens are sealed together in the same AES-256-GCM envelope as keys; only the expiries, the company's id for the account and the state can be read.
model PartnerOAuthToken {
  id               String    @id @default(cuid())
  workspaceId      String    @map("workspace_id")
  provider         String
  /// The company's own id for the account connected (QuickBooks: the realm id). Not a secret: every call names it.
  accountId        String    @map("account_id")
  /// "v1.<iv>.<tag>.<ciphertext>" of { access_token, refresh_token }. Never returned by any query the screens use.
  sealed           String
  scope            String?
  accessExpiresAt  DateTime  @map("access_expires_at")
  refreshExpiresAt DateTime? @map("refresh_expires_at")
  /// A refresh is claimed by compare-and-set on this, with a short lease, so two calls never spend the same refresh token.
  version          Int       @default(0)
  refreshingUntil  DateTime? @map("refreshing_until")
  refreshedAt      DateTime? @map("refreshed_at")
  /// active | expired (the company refused the refresh token: the fleet signs in again)
  status           String    @default("active")
  lastError        String?   @map("last_error")
  connectedBy      String?   @map("connected_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
  @@map("partner_oauth_tokens")
}

/// One sign-in redirect to a partner company, used once: the state sent with it is kept only as its SHA-256, expires in minutes, and ties the callback to the fleet and person who started it.
model PartnerOAuthState {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  provider    String
  stateHash   String    @unique @map("state_hash")
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdBy   String?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("partner_oauth_states")
}

/// Which record in a partner company stands for which record on the desk (a customer, an invoice, a payment, a driver as a vendor, ...), so a sync updates instead of creating twice.
/// One desk record maps to one partner record and back, per company. `syncToken` is the company's version of its record (QuickBooks' SyncToken); `pushedHash` is what the desk last sent.
model ExternalRef {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  provider    String
  /// customer | invoice | payment | credit_memo | vendor | bill | bill_payment | item | account
  entity      String
  localId     String   @map("local_id")
  externalId  String   @map("external_id")
  syncToken   String?  @map("sync_token")
  pushedHash  String?  @map("pushed_hash")
  syncedAt    DateTime @map("synced_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider, entity, localId])
  @@unique([workspaceId, provider, entity, externalId])
  @@map("external_refs")
}

/// How far a pull from a partner company has read, per stream (QuickBooks: the time its change feed was last read to). Moved only forward, by compare-and-set, so two runs never skip or repeat.
model SyncCursor {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  provider    String
  stream      String
  cursor      String?
  lastRunAt   DateTime? @map("last_run_at")
  lastOkAt    DateTime? @map("last_ok_at")
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider, stream])
  @@map("sync_cursors")
}

/// A fleet's own name (and number) for an account its money is booked to (docs/MONEY_PLAN.md, rules D and E): an invoice line kind's income account, an expense, or a balance account.
/// A key with no row uses its default name (src/lib/accounting-map.ts); a key with neither is unmapped, and a sync or journal that needs it stops.
model AccountingAccount {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  key         String
  account     String
  number      String?
  updatedBy   String?  @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@map("accounting_accounts")
}

/// Every event a company's webhook has sent, once: the company's own event id is unique per provider, so a repeat is recognised and ignored. No body is kept (it can hold names and addresses): the kind and an outcome.
/// A key a partner system uses to read this fleet's records through the read API (docs/MONEY_PLAN.md, Wave 7 step 2; src/lib/api-keys.ts). Only the SHA-256 of the whole key is kept: the
/// key itself is shown once, when it is made. `prefix` (`tlk_live_ab12cd34`) finds the row and is what a screen shows, with `last4`.
model PartnerApiKey {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  label       String
  prefix      String    @unique
  last4       String
  hash        String
  /// What it may read: invoices | payments | settlements | loads
  scopes      String[]
  createdBy   String?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  lastUsedAt  DateTime? @map("last_used_at")
  revokedAt   DateTime? @map("revoked_at")
  revokedBy   String?   @map("revoked_by")
  /// The rate window (60 a minute): when this minute began and how many requests it has had. Moved in one UPDATE so a burst cannot slip past it.
  windowStart DateTime? @map("window_start")
  windowCount Int       @default(0) @map("window_count")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("partner_api_keys")
}

/// A receiver this fleet's money events are sent to (docs/MONEY_PLAN.md, Wave 7 step 3; src/lib/webhook-events.ts). The signing secret is sealed like a partner key (credentials-core.ts) and shown once.
model WebhookEndpoint {
  id             String    @id @default(cuid())
  workspaceId    String    @map("workspace_id")
  url            String
  label          String?
  /// The events it receives (invoice.created, payment.applied, ...).
  events         String[]
  /// "v1.<iv>.<tag>.<ciphertext>" of { secret }. Never returned by any query the screens use.
  sealedSecret   String    @map("sealed_secret")
  secretLast4    String    @map("secret_last4")
  active         Boolean   @default(true)
  /// Dead deliveries in a row; three switch the endpoint off (disabledAt) until an admin switches it on again.
  deadInARow     Int       @default(0) @map("dead_in_a_row")
  disabledAt     DateTime? @map("disabled_at")
  disabledReason String?   @map("disabled_reason")
  createdBy      String?   @map("created_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([workspaceId, active])
  @@map("webhook_endpoints")
}

/// The outbox: one row per event and endpoint, written in the same transaction as the money change it reports, delivered later by the partner schedule. Never written with an HTTP call open.
model WebhookDelivery {
  id            String    @id @default(cuid())
  workspaceId   String    @map("workspace_id")
  endpointId    String    @map("endpoint_id")
  /// evt_...: the same on every retry and every endpoint, what a receiver keeps to do each event once.
  eventId       String    @map("event_id")
  type          String
  /// The body exactly as it is sent, every time.
  payload       Json
  /// pending | sent | failed | dead
  status        String    @default("pending")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at")
  /// Held by one schedule run while it sends (claimed with FOR UPDATE SKIP LOCKED), so two runs never send the same row.
  leaseUntil    DateTime? @map("lease_until")
  lastStatus    Int?      @map("last_status")
  lastError     String?   @map("last_error")
  sentAt        DateTime? @map("sent_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  /// A person settled a failed or dead delivery on Partner issues: resolved | dismissed, with what they said (Wave 7 step 4).
  resolvedAt     DateTime? @map("resolved_at")
  resolvedBy     String?   @map("resolved_by")
  resolution     String?
  resolutionNote String?   @map("resolution_note")

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  endpoint  WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@unique([endpointId, eventId])
  @@index([status, nextAttemptAt])
  @@index([workspaceId, createdAt])
  @@map("webhook_deliveries")
}

model PartnerEvent {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  provider    String
  eventId     String   @map("event_id")
  kind        String
  /// received (being applied) | applied | ignored | failed
  outcome     String
  detail      String?
  receivedAt  DateTime @default(now()) @map("received_at")
  /// The verified body, kept only while it may be needed again (D6, Wave 7 step 4): an event being applied, one that failed, or one ignored for a reason a person can fix (an invoice
  /// number the desk does not know). Cleared when it applies. At most 256 KB (the webhook limit).
  payload     String?
  /// When it was last tried (first received, a company's redelivery, or a replay from the desk).
  attemptedAt DateTime? @map("attempted_at")
  /// A person settled it on Partner issues: resolved | dismissed, with what they said.
  resolvedAt  DateTime? @map("resolved_at")
  resolvedBy  String?   @map("resolved_by")
  resolution  String?
  resolutionNote String? @map("resolution_note")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([provider, eventId])
  @@index([workspaceId, receivedAt])
  @@index([workspaceId, outcome])
  @@map("partner_events")
}

/// What still has to be told to a driver's phone: written in the same transaction as the desk change it follows (send, change, reassign, unassign), then delivered and retried by the flusher.
/// No payload is kept: the summary is rebuilt from the load at delivery time, so a late delivery sends the current truth, checked again for anything a driver must not see.
model BridgeOutbox {
  id            String    @id @default(cuid())
  workspaceId   String    @map("workspace_id")
  loadId        String    @map("load_id")
  /// dispatch | update | reassign_old | cancel
  kind          String
  /// The driver the row is for (their phone account), so a reassign can say who is being taken off.
  phoneUserId   String    @map("phone_user_id")
  /// The bridge row to supersede or cancel (reassign_old and cancel), else null.
  dispatchId    String?   @map("dispatch_id")
  /// pending | done | failed
  status        String    @default("pending")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at")
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at")
  doneAt        DateTime? @map("done_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, nextAttemptAt])
  @@index([loadId])
  @@map("bridge_outbox")
}

/// The desk's conversation with one driver: one thread per driver, newest message last. A message can be about a load (its chip links to it).
/// Today nothing carries a message to the driver's phone, so `Message.deliveredAt` stays empty and the screen says the message is saved on the desk only.
model Thread {
  id            String   @id @default(cuid())
  workspaceId   String   @map("workspace_id")
  driverId      String   @unique @map("driver_id")
  lastMessageAt DateTime @default(now()) @map("last_message_at")
  createdAt     DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  driver    Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([workspaceId, lastMessageAt])
  @@map("threads")
}

/// One message in a thread. direction: out (the dispatcher wrote it) | in (the driver wrote it) | system (the desk noted something, such as a load being sent).
/// `clientId` is the browser's own id for a send, so a double click or a retry saves it once. `readAt` matters for `in`: empty means the dispatcher has not opened it.
model Message {
  id          String    @id @default(cuid())
  threadId    String    @map("thread_id")
  direction   String
  body        String
  loadId      String?   @map("load_id")
  clientId    String?   @map("client_id")
  sentAt      DateTime  @default(now()) @map("sent_at")
  deliveredAt DateTime? @map("delivered_at")
  readAt      DateTime? @map("read_at")

  thread      Thread              @relation(fields: [threadId], references: [id], onDelete: Cascade)
  load        Load?               @relation(fields: [loadId], references: [id], onDelete: SetNull)
  attachments MessageAttachment[]

  @@unique([threadId, clientId])
  @@index([threadId, sentAt])
  @@index([direction, readAt])
  @@map("messages")
}

/// A person on a desk. Sign-in proves who someone is (the provider's user id); this says which workspace they work in and as what: viewer, dispatcher or owner. A person is added
/// by an owner (or by whoever provisions the workspace) with an email before they have signed in; the first verified sign-in with that email binds the provider's user id,
/// and from then on the user id is what is matched. A plan holds only so many people (seats).
model Member {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  email       String
  name        String
  role        String    @default("dispatcher")
  /// Extra things an admin lets this person do on top of their role (only "bill" for a dispatcher: the billing office's work). Unknown values are ignored when read.
  grants      String[]  @default([])
  /// The sign-in provider's user id; null until the person first signs in. One person is on one desk.
  clerkUserId String?   @unique @map("clerk_user_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  lastSeenAt  DateTime? @map("last_seen_at")

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  scopes    MemberScope[]

  @@unique([workspaceId, email])
  @@index([email])
  @@map("members")
}

/// Someone who asked for an account. Not tied to a workspace: it exists before one does. kind: self_serve (under 50 trucks) | enterprise (50 or more: a person sets
/// them up). The kind is worked out from `trucks` on the server, never taken from the form. status: open | contacted | provisioned | declined; `workspaceId`
/// names the workspace made for them once provisioned (a plain column, so removing a workspace never removes the record that it was asked for).
model SignupRequest {
  id          String   @id @default(cuid())
  kind        String
  name        String
  company     String
  role        String?
  email       String
  phone       String?
  trucks      Int
  mcNumber    String?  @map("mc_number")
  bestTime    String?  @map("best_time")
  note        String?
  status      String   @default("open")
  workspaceId String?  @map("workspace_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([status, kind, createdAt])
  @@map("signup_requests")
}

/// A payment received against an invoice: the amount, the day it came in (Dallas calendar, kept as a timestamp) and how. An invoice paid in part has one or more of these and stays
/// out with a balance; the load's `paidAmount` is their sum. `kind` is payment, or the last row of an invoice closed short on purpose is still a payment (what was written off is the
/// difference, kept with its reason in the audit entry). Taking a payment back removes its row.
model LoadPayment {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  loadId      String   @map("load_id")
  amount      Decimal  @db.Decimal(12, 2)
  paidAt      DateTime @map("paid_at")
  method      String?
  createdAt   DateTime @default(now()) @map("created_at")

  load Load @relation(fields: [loadId], references: [id], onDelete: Cascade)

  @@index([loadId])
  @@index([workspaceId])
  @@map("load_payments")
}

/// A document kept on a load: the rate confirmation it was booked from, the proof of delivery, a receipt, anything else. The bytes are in the desk's private storage (never a public
/// address); this row names them (`storageKey`), says what they are (`kind`: rate_con | pod | receipt | other) and what they were checked to be (type, size, SHA-256). Factoring
/// reads these rows to know what it can send: a document that is not here is not in the packet.
model LoadDocument {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  loadId      String   @map("load_id")
  kind        String
  name        String
  mime        String
  bytes       Int
  sha256      String
  storageKey  String   @map("storage_key")
  addedBy     String   @map("added_by")
  /// The delivery stop a proof of delivery belongs to, when it is one stop's.
  stopId      String?  @map("stop_id")
  createdAt   DateTime @default(now()) @map("created_at")

  load Load @relation(fields: [loadId], references: [id], onDelete: Cascade)

  @@index([loadId])
  @@index([workspaceId])
  @@map("load_documents")
}

/// A picture or a file on a message (the phone's own limits: up to 4 a message, 10 MB each). kind: image | file. `storageKey` names the bytes in the desk's private
/// storage (never a public address); `sha256` is of the stored bytes. The type was checked against the file's real signature before it was kept.
model MessageAttachment {
  id         String   @id @default(cuid())
  messageId  String   @map("message_id")
  kind       String
  name       String?
  mime       String
  bytes      Int
  sha256     String
  storageKey String   @map("storage_key")
  createdAt  DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("message_attachments")
}

/// One claimed unit of paid-service spend (spend-guardrails plan, docs/platform/SPEND_GUARDRAILS.md): a rate-confirmation read, a Mapbox call. Written BEFORE the paid call by
/// server/tl/usage.ts `claimUsage` (one caller at a time per service) and removed again if the call never happened. `workspaceId` is a plain column (usage outlives a workspace),
/// `estCents` an estimate used only for the monthly dollar ceiling. Rows older than 70 days are deleted as claims are made.
model ServiceUsage {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  service     String
  units       Int      @default(1)
  estCents    Int      @default(0) @map("est_cents")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([service, createdAt])
  @@index([workspaceId, service, createdAt])
  @@map("service_usage")
}

/// A quarter's miles in one US jurisdiction (IFTA) as the ELD reported them, one row per trip piece (money plan Wave 5 step 5a): loaded on a load (`loadId`) or empty (`loadId` null), with the
/// start and end odometer and time, so the per-truck audit (step 7) has every mile's backing detail. A piece belongs to the quarter it starts in. A re-sync replaces the answered trucks' rows for
/// the quarter under the workspace lock (server/partners/ifta-mileage.ts); the unique key on the company's piece id is the backstop against a doubled piece. Canadian provinces are counted in the
/// sync's result and audit but not stored (gap 15). A piece whose load is later removed keeps `loaded` with `loadId` null.
model IftaMileage {
  id            String   @id @default(cuid())
  workspaceId   String   @map("workspace_id")
  vehicleId     String   @map("vehicle_id")
  /// "2026-Q3".
  quarter       String
  /// Two-letter US code (DC included).
  jurisdiction  String
  /// The company that reported it ("motive").
  source        String
  /// The company's piece id and jurisdiction.
  externalId    String   @map("external_id")
  /// "eld" (the ELD reported it) or "routed" (the mileage company routed it from the truck's loads, step 5b). A truck with ELD rows for the quarter uses only those.
  method        String   @default("eld")
  loadId        String?  @map("load_id")
  loaded        Boolean
  /// Blank on a routed row only.
  startOdometer Decimal? @map("start_odometer") @db.Decimal(12, 1)
  endOdometer   Decimal? @map("end_odometer") @db.Decimal(12, 1)
  /// What the ELD measured (or the router routed) for the piece.
  miles         Decimal  @db.Decimal(12, 1)
  startedAt     DateTime @map("started_at")
  endedAt       DateTime @map("ended_at")
  syncBatchId   String   @map("sync_batch_id")
  syncedAt      DateTime @map("synced_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  load      Load?     @relation(fields: [loadId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, source, externalId])
  @@index([workspaceId, quarter, vehicleId])
  @@index([loadId])
  @@map("ifta_mileage")
}

/// A filed IFTA return, frozen as it was worked out at the moment of filing (money plan Wave 5 step 8; server/partners/ifta-filing.ts). At most one FILED return per workspace and quarter (a partial
/// unique index in the migration). Reopening keeps the row ("reopened", who, when, why) and frees the quarter; filing again is an amendment (`amendsId`). A database trigger refuses any edit of
/// the figures. `rateState` is provisional | mixed | final; anything short of final was confirmed by the person filing.
model IftaReturn {
  id                   String    @id @default(cuid())
  workspaceId          String    @map("workspace_id")
  /// "2026-Q3".
  quarter              String
  /// "filed" | "reopened".
  status               String    @default("filed")
  filedAt              DateTime  @map("filed_at")
  filedBy              String    @map("filed_by")
  /// YYYY-MM-DD.
  dueDate              String    @map("due_date")
  rateState            String    @map("rate_state")
  provisionalConfirmed Boolean   @default(false) @map("provisional_confirmed")
  miles                Decimal   @db.Decimal(14, 1)
  gallons              Decimal   @db.Decimal(14, 3)
  taxPaidGallons       Decimal   @map("tax_paid_gallons") @db.Decimal(14, 3)
  bulkGallons          Decimal   @map("bulk_gallons") @db.Decimal(14, 3)
  /// Blank on a return with no miles and no fuel.
  mpg                  Decimal?  @db.Decimal(8, 2)
  tax                  Decimal   @db.Decimal(14, 2)
  surcharge            Decimal   @db.Decimal(14, 2)
  total                Decimal   @db.Decimal(14, 2)
  trucks               Int
  /// The reopened return this one amends.
  amendsId             String?   @map("amends_id")
  reopenedAt           DateTime? @map("reopened_at")
  reopenedBy           String?   @map("reopened_by")
  reopenReason         String?   @map("reopen_reason")
  createdAt            DateTime  @default(now()) @map("created_at")

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  amends    IftaReturn?      @relation("IftaAmends", fields: [amendsId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  amendedBy IftaReturn[]     @relation("IftaAmends")
  lines     IftaReturnLine[]

  @@index([workspaceId, quarter])
  @@map("ifta_returns")
}

/// One jurisdiction of a filed IFTA return, frozen with it.
model IftaReturnLine {
  id             String  @id @default(cuid())
  returnId       String  @map("return_id")
  jurisdiction   String
  miles          Decimal @db.Decimal(14, 1)
  taxableGallons Decimal @map("taxable_gallons") @db.Decimal(14, 0)
  taxPaidGallons Decimal @map("tax_paid_gallons") @db.Decimal(14, 0)
  netGallons     Decimal @map("net_gallons") @db.Decimal(14, 0)
  rate           Decimal @db.Decimal(8, 4)
  surchargeRate  Decimal @map("surcharge_rate") @db.Decimal(8, 4)
  tax            Decimal @db.Decimal(14, 2)
  surcharge      Decimal @db.Decimal(14, 2)
  total          Decimal @db.Decimal(14, 2)

  return IftaReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@unique([returnId, jurisdiction])
  @@map("ifta_return_lines")
}

/// A quarter's fuel-tax rate for one US jurisdiction (IFTA), per workspace: what the return (Wave 5 step 6) multiplies by. Loaded from a rate file (modelled on IFTA, Inc.'s quarterly rate
/// table, an assumption) or as labelled sample rates for a demo. A file replaces the whole quarter. US dollars a gallon only; Canadian rows are counted and skipped (gap 15).
/// `rate` and `surcharge` stay apart: the fuel-bought credit applies to `rate` only, never to `surcharge`.
model IftaRate {
  id            String   @id @default(cuid())
  workspaceId   String   @map("workspace_id")
  /// "2026-Q3".
  quarter       String
  /// Two-letter US code (DC included).
  jurisdiction  String
  /// Base diesel rate, dollars a gallon.
  rate          Decimal  @db.Decimal(8, 4)
  /// A separate surcharge rate, dollars a gallon (0 where the state has none). No credit for fuel bought.
  surcharge     Decimal  @default(0) @db.Decimal(8, 4)
  /// "provisional" | "final".
  status        String
  /// Made-up rates for a demo: shown as "sample, not for filing".
  isSample      Boolean  @default(false) @map("is_sample")
  /// The file the rate came from ("sample" for sample rates).
  sourceFile    String?  @map("source_file")
  importBatchId String?  @map("import_batch_id")
  createdAt     DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, quarter, jurisdiction])
  @@map("ifta_rates")
}

/// A fuel card purchase, as the card company reported it: kept so fuel can be listed, tied to the load it was bought for and followed to the driver statement that load is on. One row per
/// purchase (the company's own id), so reading the same days twice never doubles it. `amount` is what the card was charged after the discount.
model FuelTransaction {
  id                String    @id @default(cuid())
  workspaceId       String    @map("workspace_id")
  provider          String
  externalId        String    @map("external_id")
  vehicleId         String?   @map("vehicle_id")
  loadId            String?   @map("load_id")
  postedAt          DateTime  @map("posted_at")
  location          String?
  /// Where it was bought, read cleanly (lib/fuel-normalize.ts): a two-letter US state or Canadian province, and the city. Fuel tax credits the gallons to this jurisdiction. Blank when the source did not say.
  purchaseState     String?   @map("purchase_state")
  purchaseCity      String?   @map("purchase_city")
  /// What was pumped: road_diesel (the tractor's tank, IFTA fuel), reefer_diesel (the trailer's unit), def (exhaust fluid), gasoline, other, or unknown when the source did not say.
  product           String    @default("unknown")
  /// Tax was paid at the pump (a retail purchase). Bulk fuel from the fleet's own tank is not: it counts toward miles to the gallon but earns no tax-paid credit.
  taxPaid           Boolean   @default(true) @map("tax_paid")
  /// The moment of purchase when the source gives one (postedAt stays the calendar day, at noon UTC).
  purchasedAt       DateTime? @map("purchased_at")
  /// settled (the default), pending, declined or void. Only settled purchases are offered on a statement or counted in fuel and fuel-tax totals.
  status            String    @default("settled")
  /// The CSV import that brought this purchase in (provider "csv"), so the whole file can be taken away again. Null for a purchase read from a card company.
  importBatchId     String?   @map("import_batch_id")
  gallons           Decimal?  @db.Decimal(10, 3)
  pricePerGallon    Decimal?  @map("price_per_gallon") @db.Decimal(8, 4)
  discountPerGallon Decimal?  @map("discount_per_gallon") @db.Decimal(8, 4)
  discount          Decimal?  @db.Decimal(12, 2)
  amount            Decimal   @db.Decimal(12, 2)
  createdAt         DateTime  @default(now()) @map("created_at")

  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  vehicle      Vehicle?         @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  load         Load?            @relation(fields: [loadId], references: [id], onDelete: SetNull)
  /// The driver statement this purchase was deducted on (set when that statement is finalized, cleared if it is voided). A purchase is deducted once.
  settlementId String?          @map("settlement_id")
  settlement   Settlement?      @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  flagReviews  FuelFlagReview[]

  @@unique([workspaceId, provider, externalId])
  @@index([workspaceId, postedAt])
  @@index([workspaceId, purchaseState])
  @@index([workspaceId, importBatchId])
  @@index([loadId])
  @@index([settlementId])
  @@map("fuel_transactions")
}

/// A person's review of one exception flag on one fuel purchase (Wave 5 step 3): the flag is cleared, with why. Keyed by purchase AND flag code, so clearing one reason never hides another on
/// the same purchase. Removing the row reopens the flag. The flags themselves are worked out each time (lib/fuel-exceptions.ts); only the person's decision is kept.
model FuelFlagReview {
  id                String   @id @default(cuid())
  workspaceId       String   @map("workspace_id")
  fuelTransactionId String   @map("fuel_transaction_id")
  /// The flag cleared: one of FLAG_CODES in lib/fuel-exceptions.ts.
  code              String
  note              String
  reviewedBy        String   @map("reviewed_by")
  reviewedAt        DateTime @map("reviewed_at")

  workspace       Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fuelTransaction FuelTransaction @relation(fields: [fuelTransactionId], references: [id], onDelete: Cascade)

  @@unique([fuelTransactionId, code])
  @@index([workspaceId])
  @@map("fuel_flag_reviews")
}

/// A terminal (yard, branch, region) as a named list the desk manages. Drivers, trucks and trailers keep their `terminal` text column, which now holds one of these names; a driver's terminal is
/// their home base, not a fence (anyone can be assigned a load from anywhere). Seeded from the distinct values in use. Names are unique per workspace regardless of case (an index on lower(name)).
model Terminal {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  name        String
  city        String?
  note        String?
  /// The region this terminal belongs to, or none yet (shown as "Unassigned"). Units stay assigned to a terminal; a region only groups terminals.
  regionId    String?   @map("region_id")
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  region    Region?   @relation(fields: [regionId], references: [id], onDelete: SetNull)

  @@index([workspaceId, archivedAt])
  @@index([regionId])
  @@map("terminals")
}

/// A group of terminals (Texas, the Southeast): what a dispatcher, a driver manager or an admin can be pointed at, so a big fleet is read one region at a time. A region owns no trucks or drivers; they stay
/// assigned to a terminal, and a terminal belongs to at most one region. Retiring a region leaves its terminals unassigned.
model Region {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  name        String
  note        String?
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  terminals Terminal[]
  scopes    MemberScope[]

  @@index([workspaceId, archivedAt])
  @@map("regions")
}

/// What a member may see: a region (all its terminals) or one terminal, by name. A member with no rows is not limited (and an admin never is). The server enforces it on every list; the header's scope
/// is a choice inside what is allowed, never a way out of it.
model MemberScope {
  id        String   @id @default(cuid())
  memberId  String   @map("member_id")
  regionId  String?  @map("region_id")
  /// A terminal's name, kept in step when the terminal is renamed.
  terminal  String?
  createdAt DateTime @default(now()) @map("created_at")

  member Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  region Region? @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@map("member_scopes")
}

/// A driver's weekly shift template on the carrier's clock. `week` is seven entries Sunday to Saturday, each `{ "start": minutes, "end": minutes }` for a shift that starts that day (an end at or before
/// the start runs past midnight into the next morning) or null for a day off. No row means no schedule set: the driver is neither on nor off, and is never flagged.
model DriverSchedule {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  driverId    String   @unique @map("driver_id")
  week        Json
  setBy       String?  @map("set_by")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  driver    Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("driver_schedules")
}

/// One date that differs from the template: time off, home time (kind off) or a different shift for that day (kind shift, with its start and end in minutes). `dateKey` is the day the shift starts, YYYY-MM-DD on the carrier's clock.
model DriverShiftException {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  driverId    String   @map("driver_id")
  dateKey     String   @map("date_key")
  kind        String
  startMinute Int?     @map("start_minute")
  endMinute   Int?     @map("end_minute")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  driver    Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([driverId, dateKey])
  @@index([workspaceId, dateKey])
  @@map("driver_shift_exceptions")
}

/// One position fix from the ELD for a tractor, kept for a week: the breadcrumb on a load's tracking tab, and where the idle time went. Unique per (vehicle, instant) so a re-read never writes it twice.
model VehiclePing {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  vehicleId   String   @map("vehicle_id")
  lat         Decimal  @db.Decimal(9, 6)
  lng         Decimal  @db.Decimal(9, 6)
  speedMph    Decimal? @map("speed_mph") @db.Decimal(5, 1)
  headingDeg  Int?     @map("heading_deg")
  engine      String?
  at          DateTime
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, at])
  @@index([vehicleId, at(sort: Desc)])
  @@index([workspaceId, at])
  @@map("vehicle_pings")
}

/// A call to a driver, or a word from one, about where a truck or trailer is and when it will get there. A business record kept with the asset: it is how a late load or a detention claim is settled
/// later. `at` is when the call happened (a dispatcher can back-date it); `createdAt` is when it was typed in. Nothing here is read by money, the quote or the verdict.
model CheckCall {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  vehicleId   String?   @map("vehicle_id")
  trailerId   String?   @map("trailer_id")
  loadId      String?   @map("load_id")
  at          DateTime
  /// What the driver said about where they are: "I-40 past Amarillo", "in the yard, door 4".
  place       String?
  /// When the driver said they would arrive.
  etaAt       DateTime? @map("eta_at")
  /// on_time, late or issue; blank when not said.
  status      String?
  note        String?
  spokeWith   String?   @map("spoke_with")
  loggedBy    String    @map("logged_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  vehicle   Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  trailer   Trailer?  @relation(fields: [trailerId], references: [id], onDelete: Cascade)
  load      Load?     @relation(fields: [loadId], references: [id], onDelete: SetNull)

  @@index([vehicleId, at(sort: Desc)])
  @@index([trailerId, at(sort: Desc)])
  @@index([loadId, at])
  @@index([workspaceId, at])
  @@map("check_calls")
}

/// A stretch of time a tractor stood in one place (engine off or idling, at least twenty minutes), written as the ELD is read: it opens when the tractor stops, grows while it stays, and closes with
/// `leftAt` when it moves on. Raw fixes are kept a week (VehiclePing); these are what is kept for the longer record of where a truck has been and when.
model UnitStay {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  vehicleId   String    @map("vehicle_id")
  lat         Decimal   @db.Decimal(9, 6)
  lng         Decimal   @db.Decimal(9, 6)
  arrivedAt   DateTime  @map("arrived_at")
  /// The last fix that still put it here.
  lastSeenAt  DateTime  @map("last_seen_at")
  /// Set when a fix puts it somewhere else; blank while it is still there.
  leftAt      DateTime? @map("left_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, arrivedAt(sort: Desc)])
  @@index([workspaceId, arrivedAt])
  @@map("unit_stays")
}

/// A trailer hooked to a tractor or dropped, with where the tractor was at that moment, so a trailer's trail (which tractor pulled it, where it was left, how long it sat) can be read back.
model TrailerMove {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  trailerId   String   @map("trailer_id")
  /// The tractor it was hooked to, or dropped from.
  vehicleId   String?  @map("vehicle_id")
  /// hooked or dropped.
  kind        String
  at          DateTime
  lat         Decimal? @db.Decimal(9, 6)
  lng         Decimal? @db.Decimal(9, 6)
  byName      String   @map("by_name")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  trailer   Trailer   @relation(fields: [trailerId], references: [id], onDelete: Cascade)
  vehicle   Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([trailerId, at(sort: Desc)])
  @@index([vehicleId, at(sort: Desc)])
  @@map("trailer_moves")
}

/// What a lane should pay per load, set by a person (the lane is the KPI's own key, "origin -> destination"). The Lanes scorecard compares each lane's revenue per load with it: BELOW, OK, or no target.
model LaneTarget {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  lane        String
  /// Dollars per load, all in.
  targetRate  Decimal  @map("target_rate") @db.Decimal(12, 2)
  setBy       String?  @map("set_by")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, lane])
  @@map("lane_targets")
}

/// The weekly on-highway diesel price (EIA), kept whenever the desk reads it, so the fuel surcharge summary can compare this week with last. Shared by every fleet (a public price, no workspace).
model DieselPrice {
  id        String   @id @default(cuid())
  /// The EIA week (a date, YYYY-MM-DD) and the region it is for (NUS national, R10 to R50 regional).
  weekOf    String   @map("week_of")
  region    String
  price     Decimal  @db.Decimal(6, 3)
  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@unique([weekOf, region])
  @@map("diesel_prices")
}

/// "Notes for the call": what the person wants said about a week when the report is read out, one per week (`weekKey` is the Monday, YYYY-MM-DD, on the workspace's clock).
model KpiNote {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  weekKey     String   @map("week_key")
  body        String
  updatedBy   String?  @map("updated_by")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, weekKey])
  @@map("kpi_notes")
}

/// One lane's week from a carrier's own weekly tracker (a spreadsheet of lane-per-week totals, not a list of loads). It feeds the trends only and is shown as "imported history": it is never turned into loads and
/// never added to a figure built from loads. `weekStart` is the Monday of the week. A batch is every row of one file, so an import can be taken away whole.
model ImportedHistory {
  id            String   @id @default(cuid())
  workspaceId   String   @map("workspace_id")
  batchId       String   @map("batch_id")
  weekStart     DateTime @map("week_start") @db.Date
  lane          String
  loads         Int
  lineHaul      Decimal  @map("line_haul") @db.Decimal(12, 2)
  fuelSurcharge Decimal  @default(0) @map("fuel_surcharge") @db.Decimal(12, 2)
  loadedMiles   Decimal  @map("loaded_miles") @db.Decimal(12, 1)
  emptyMiles    Decimal  @default(0) @map("empty_miles") @db.Decimal(12, 1)
  source        String
  createdAt     DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, weekStart, lane])
  @@index([workspaceId, batchId])
  @@map("imported_history")
}

/// An alert the desk derives on every request (src/lib/alerts.ts), kept: when it was first seen, whether someone acknowledged it, when it cleared, what was sent about it (docs/SIGNALS.md).
/// `key` is the alert's own key (the load and the rule), unique per desk, so a signal that clears and returns is reopened, not a second row. Written only by syncSignals under the workspace lock.
model Signal {
  id            String    @id @default(cuid())
  workspaceId   String    @map("workspace_id")
  key           String
  code          String
  /// block | warn | info (checked in the migration).
  level         String
  title         String
  detail        String
  loadId        String?   @map("load_id")
  loadNumber    String?   @map("load_number")
  /// open | acknowledged | resolved (checked in the migration).
  status        String    @default("open")
  firstSeenAt   DateTime  @map("first_seen_at")
  lastSeenAt    DateTime  @map("last_seen_at")
  resolvedAt    DateTime? @map("resolved_at")
  reopenCount   Int       @default(0) @map("reopen_count")
  ackedBy       String?   @map("acked_by")
  ackedAt       DateTime? @map("acked_at")
  /// The most severe level a notification has already gone out for, so a signal is sent once per level it reaches.
  lastLevelSent String?   @map("last_level_sent")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  load      Load?             @relation(fields: [loadId], references: [id], onDelete: SetNull)
  sends     NotificationLog[]

  @@unique([workspaceId, key])
  @@index([workspaceId, status, level])
  @@index([loadId])
  @@map("signals")
}

/// One row per thing sent and channel, per desk. The unique dedupe key is the database-level guarantee that a notification goes out once, whatever races: the second insert of the same key fails.
model NotificationLog {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  /// signal | weekly_report (checked in the migration).
  kind        String
  /// What makes this send unique: the channel, the thing and the level or the ISO week.
  dedupeKey   String    @map("dedupe_key")
  channel     String
  /// queued | sent | failed | skipped (checked in the migration).
  state       String    @default("queued")
  attempts    Int       @default(0)
  /// A short reason only, never a body or a secret.
  error       String?
  /// The subject line of what was sent (a line of words: never a body, a key or an address), so the desk can show what went out.
  subject     String?
  signalId    String?   @map("signal_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  nextTryAt   DateTime? @map("next_try_at")
  sentAt      DateTime? @map("sent_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  signal    Signal?   @relation(fields: [signalId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, dedupeKey])
  @@index([workspaceId, state])
  @@map("notification_log")
}

/// What the trucks own track says about one stop, frozen when the load was delivered (the position fixes themselves are deleted after a week), so a detention claim weeks later still has its proof.
/// A proposal changes nothing; a person confirms it (src/server/tl/detention-evidence.ts). One row per stop. Kept with the load; removed only with it.
model StopEvidence {
  id                   String    @id @default(cuid())
  workspaceId          String    @map("workspace_id")
  loadId               String    @map("load_id")
  stopId               String    @unique @map("stop_id")
  vehicleId            String?   @map("vehicle_id")
  /// proposed | confirmed | dismissed (checked in the migration).
  state                String    @default("proposed")
  /// good | thin | none (checked in the migration).
  quality              String
  radiusMiles          Decimal   @map("radius_miles") @db.Decimal(5, 3)
  /// The fixes within two miles of the stop: [{at (epoch ms), lat, lng, miles}], oldest first, at most 200.
  fixes                Json
  fixCount             Int       @map("fix_count")
  insideCount          Int       @map("inside_count")
  windowStart          DateTime? @map("window_start")
  windowEnd            DateTime? @map("window_end")
  proposedArrivalAt    DateTime? @map("proposed_arrival_at")
  proposedDepartureAt  DateTime? @map("proposed_departure_at")
  beforeGapMin         Int?      @map("before_gap_min")
  afterGapMin          Int?      @map("after_gap_min")
  stillInside          Boolean   @default(false) @map("still_inside")
  visitCount           Int       @default(0) @map("visit_count")
  waitFrom             DateTime? @map("wait_from")
  proposedWaitMinutes  Int?      @map("proposed_wait_minutes")
  /// SHA-256 of the canonical evidence (src/lib/detention-evidence.ts canonicalEvidence), so the sheet can show it was not edited.
  sha256               String
  frozenAt             DateTime  @map("frozen_at")
  decidedBy            String?   @map("decided_by")
  decidedAt            DateTime? @map("decided_at")
  confirmedArrivalAt   DateTime? @map("confirmed_arrival_at")
  confirmedWaitMinutes Int?      @map("confirmed_wait_minutes")
  /// True when the person confirmed a figure that differs from the proposal.
  edited               Boolean   @default(false)
  /// False when the person confirmed it as proof only (the load was already invoiced, so no stop was changed).
  wroteToStop          Boolean   @default(false) @map("wrote_to_stop")
  note                 String?
  createdAt            DateTime  @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  load      Load      @relation(fields: [loadId], references: [id], onDelete: Cascade)
  stop      Stop      @relation(fields: [stopId], references: [id], onDelete: Cascade)
  vehicle   Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([workspaceId, state])
  @@index([loadId])
  @@map("stop_evidence")
}

/// An invoice as its own record (docs/MONEY_PLAN.md, Wave 1). It can carry one load or several, and it keeps its lines, its payments and where it stands
/// with a factor. During the move from "invoice fields on the load" the load keeps a projection of its invoice (invoice_number, invoiced_amount, paid_amount,
/// payment_status) written by the same transaction, so every older reader still sees the same numbers; tests check the two never disagree.
model Invoice {
  id                       String    @id @default(cuid())
  workspaceId              String    @map("workspace_id")
  number                   String
  /// invoice | credit_memo. A credit memo has a negative total and names the invoice it credits.
  kind                     String    @default("invoice")
  /// open | paid | void. "Part paid" is an open invoice with paid_total above zero.
  status                   String    @default("open")
  billToName               String?   @map("bill_to_name")
  billToMc                 String?   @map("bill_to_mc")
  billToEmail              String?   @map("bill_to_email")
  billToPhone              String?   @map("bill_to_phone")
  issuedAt                 DateTime  @map("issued_at")
  termsDays                Int       @default(0) @map("terms_days")
  total                    Decimal   @db.Decimal(12, 2)
  paidTotal                Decimal   @default(0) @map("paid_total") @db.Decimal(12, 2)
  paidAt                   DateTime? @map("paid_at")
  writeOffAmount           Decimal?  @map("write_off_amount") @db.Decimal(12, 2)
  writeOffReason           String?   @map("write_off_reason")
  /// Why it closed short, as a code a report can count: quick_pay_fee | factor_fee | customer_deduction | damage_claim | negotiated | other.
  writeOffCode             String?   @map("write_off_code")
  creditOfId               String?   @map("credit_of_id")
  voidedAt                 DateTime? @map("voided_at")
  voidReason               String?   @map("void_reason")
  /// Where it stands with a factor: none | requested | submitted | funded | rejected | paid (the same words as the load's factoring_status).
  factoringStatus          String    @default("none") @map("factoring_status")
  factoringReferenceId     String?   @map("factoring_reference_id")
  factoringUpdatedAt       DateTime? @map("factoring_updated_at")
  /// What the factor advanced, charged and held on this invoice, and what came back (docs/MONEY_PLAN.md, Wave 2).
  factoringAdvance         Decimal?  @map("factoring_advance") @db.Decimal(12, 2)
  factoringFee             Decimal?  @map("factoring_fee") @db.Decimal(12, 2)
  factoringReserve         Decimal?  @map("factoring_reserve") @db.Decimal(12, 2)
  factoringReserveReleased Decimal?  @map("factoring_reserve_released") @db.Decimal(12, 2)
  factoringChargeback      Decimal?  @map("factoring_chargeback") @db.Decimal(12, 2)
  /// When the notice of assignment (the factor's remit-to) was put on this invoice's PDF.
  noaAppliedAt             DateTime? @map("noa_applied_at")
  /// When the factor funded it (the advance was paid): the journal dates the advance and the fee by it. Kept after a chargeback.
  factoringFundedAt        DateTime? @map("factoring_funded_at")
  /// When the factor released the reserve (the customer paid it): the journal and QuickBooks date the release by it. Cleared when that payment is taken back.
  factoringReserveReleasedAt DateTime? @map("factoring_reserve_released_at")
  /// When the factor charged it back (recourse): the end of the factor's ownership for the journal and QuickBooks.
  factoringChargedBackAt   DateTime? @map("factoring_charged_back_at")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")

  workspace Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creditOf  Invoice?                @relation("CreditMemo", fields: [creditOfId], references: [id], onDelete: SetNull)
  credits   Invoice[]               @relation("CreditMemo")
  lines     InvoiceLine[]
  loads     InvoiceLoad[]
  payments  InvoicePayment[]
  batches   FactoringBatchInvoice[]

  @@unique([workspaceId, number])
  @@index([workspaceId, status, issuedAt])
  @@index([workspaceId, kind])
  @@map("invoices")
}

/// One line of an invoice, typed so a report or a partner can tell detention from lumper without reading the label.
model InvoiceLine {
  id        String  @id @default(cuid())
  invoiceId String  @map("invoice_id")
  loadId    String? @map("load_id")
  /// linehaul | fuel_surcharge | detention | lumper | layover | tonu | stop_off | credit | other
  kind      String
  label     String
  amount    Decimal @db.Decimal(12, 2)
  sort      Int     @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  load    Load?   @relation(fields: [loadId], references: [id], onDelete: SetNull)

  @@index([invoiceId, sort])
  @@index([loadId])
  @@map("invoice_lines")
}

/// Which loads an invoice bills. A load is on at most one invoice that is not void (checked in the one write path).
model InvoiceLoad {
  invoiceId String @map("invoice_id")
  loadId    String @map("load_id")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  load    Load    @relation(fields: [loadId], references: [id], onDelete: Cascade)

  @@id([invoiceId, loadId])
  @@index([loadId])
  @@map("invoice_loads")
}

/// Money received against an invoice: what, when, how, and the reference that ties it to the bank, the check or the partner that reported it.
model InvoicePayment {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  invoiceId   String   @map("invoice_id")
  amount      Decimal  @db.Decimal(12, 2)
  paidAt      DateTime @map("paid_at")
  /// ach | check | wire | card | factoring | other
  method      String?
  /// The check number, ACH trace or remittance id.
  reference   String?
  /// Who paid it, when not the customer billed (a factor, a quick-pay service).
  payer       String?
  note        String?
  /// desk | factor | accounting | import | legacy: who recorded it.
  source      String   @default("desk")
  /// The partner's own id for this payment, so reading the same payment twice never doubles it.
  externalId  String?  @map("external_id")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoice   Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, source, externalId])
  @@index([invoiceId, paidAt])
  @@map("invoice_payments")
}

/// A fleet's own factoring terms: where a factored invoice must be paid (the notice of assignment), and the advance and fee the factor charges. Printed on the invoice PDF once an invoice is factored.
model FactoringTerms {
  workspaceId      String   @id @map("workspace_id")
  /// How the factor takes invoices: api | batch.
  transport        String   @default("api")
  /// For a batch: sftp | email, and where to.
  batchMethod      String?  @map("batch_method")
  batchDestination String?  @map("batch_destination")
  factorName       String?  @map("factor_name")
  remitName        String?  @map("remit_name")
  remitAddress     String?  @map("remit_address")
  lockboxBank      String?  @map("lockbox_bank")
  routingNumber    String?  @map("routing_number")
  accountNumber    String?  @map("account_number")
  noaText          String?  @map("noa_text")
  advancePct       Decimal? @map("advance_pct") @db.Decimal(5, 2)
  feePct           Decimal? @map("fee_pct") @db.Decimal(5, 2)
  updatedBy        String?  @map("updated_by")
  updatedAt        DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("factoring_terms")
}

/// A batch of invoices sent to a factor as files (a schedule of accounts and one PDF packet each) by SFTP or email (docs/MONEY_PLAN.md, Wave 2). status: queued | sent | failed | cancelled.
model FactoringBatch {
  id           String    @id @default(cuid())
  workspaceId  String    @map("workspace_id")
  number       String
  status       String    @default("queued")
  method       String
  destination  String
  invoiceCount Int       @map("invoice_count")
  total        Decimal   @db.Decimal(12, 2)
  bytes        Int       @default(0)
  attempts     Int       @default(0)
  lastError    String?   @map("last_error")
  receipt      String?
  sentAt       DateTime? @map("sent_at")
  createdBy    String?   @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  workspace Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invoices  FactoringBatchInvoice[]

  @@unique([workspaceId, number])
  @@index([workspaceId, createdAt])
  @@map("factoring_batches")
}

/// Which invoices a factoring batch carries.
model FactoringBatchInvoice {
  batchId   String @map("batch_id")
  invoiceId String @map("invoice_id")

  batch   FactoringBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  invoice Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@id([batchId, invoiceId])
  @@index([invoiceId])
  @@map("factoring_batch_invoices")
}
