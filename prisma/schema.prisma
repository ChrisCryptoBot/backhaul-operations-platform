generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════════════════════════
// TrueLane-shaped models (the demo's source of truth).
//
// These mirror TrueLane's `db/schema.ts` (WatermelonDB v56 / the synced Supabase tables): the same table
// and column names, snake_case in the database, camelCase here. Times are timestamptz here (the phone stores
// ms). The dispatcher layer (drivers, assignments) sits on top and is desktop-owned, as in the bridge
// contract (docs/CONVERGENCE_BUILD_PLAN.md): assignment is desktop-owned, execution is mobile-owned.
//
// The model names are TrueLane's own (the @@map table names match its tables). The old coordinator-task models
// (regions, weeks, drop lots, per-load task checklists and the rest) were dropped in 20261028010000.
// Status values are plain strings, as on the phone: draft | accepted | in_progress | completed | tonu | cancelled.
// ═══════════════════════════════════════════════════════════════════════════════════════════

/// The single demo workspace. Tenancy seam: TrueLane's user_id / Clerk org id lands here later.
model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  // Desk thresholds. Null means "use the default" (src/lib/thresholds.ts), so a fresh workspace needs no setup.
  emptyAmberPct         Decimal? @map("empty_amber_pct") @db.Decimal(5, 2)
  emptyRedPct           Decimal? @map("empty_red_pct") @db.Decimal(5, 2)
  defaultPayTermsDays   Int?     @map("default_pay_terms_days")
  detentionGraceMinutes Int?     @map("detention_grace_minutes")
  alertPickupHours      Int?     @map("alert_pickup_hours")
  alertSentHours        Int?     @map("alert_sent_hours")
  alertClearanceDays    Int?     @map("alert_clearance_days")

  vehicles    Vehicle[]
  loads       Load[]
  drivers     Driver[]
  auditEvents AuditEvent[]

  @@map("workspaces")
}

model Vehicle {
  id              String    @id @default(cuid())
  workspaceId     String    @map("workspace_id")
  name            String?
  make            String?
  model           String?
  year            Int?
  type            String?
  mpg             Decimal?  @db.Decimal(8, 3)
  fuelType        String?   @map("fuel_type")
  homeBaseAddress String?   @map("home_base_address")
  payloadLbs      Int?      @map("payload_lbs")
  maxLengthFt     Decimal?  @map("max_length_ft") @db.Decimal(8, 2)
  maxWidthFt      Decimal?  @map("max_width_ft") @db.Decimal(8, 2)
  maxHeightIn     Decimal?  @map("max_height_in") @db.Decimal(8, 2)
  active          Boolean   @default(true)
  archivedAt      DateTime? @map("archived_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  costProfile CostProfile?
  loads       Load[]
  drivers     Driver[]

  @@index([workspaceId])
  @@map("vehicles")
}

/// One per vehicle. Inputs to TrueLane's break-even floor (src/truelane/lib/domain/calculators.ts computeCostProfileFloorBreakdown).
model CostProfile {
  id                               String   @id @default(cuid())
  vehicleId                        String   @unique @map("vehicle_id")
  monthlyInsurance                 Decimal  @default(0) @map("monthly_insurance") @db.Decimal(12, 2)
  monthlyAuthority                 Decimal  @default(0) @map("monthly_authority") @db.Decimal(12, 2)
  monthlyPhoneSubscriptions        Decimal  @default(0) @map("monthly_phone_subscriptions") @db.Decimal(12, 2)
  monthlyLoanPayment               Decimal  @default(0) @map("monthly_loan_payment") @db.Decimal(12, 2)
  estimatedMonthlyMiles            Decimal  @map("estimated_monthly_miles") @db.Decimal(12, 2)
  maintenanceReservePerMile        Decimal  @default(0) @map("maintenance_reserve_per_mile") @db.Decimal(8, 4)
  tireReservePerMile               Decimal  @default(0) @map("tire_reserve_per_mile") @db.Decimal(8, 4)
  driverHourlyTarget               Decimal  @default(0) @map("driver_hourly_target") @db.Decimal(8, 2)
  lastFuelPricePerGallon           Decimal? @map("last_fuel_price_per_gallon") @db.Decimal(6, 3)
  breakEvenRpm                     Decimal  @map("break_even_rpm") @db.Decimal(8, 4)
  survivalFloorRpm                 Decimal? @map("survival_floor_rpm") @db.Decimal(8, 4)
  archetype                        String?
  insuranceLiabilityMonthly        Decimal? @map("insurance_liability_monthly") @db.Decimal(12, 2)
  insurancePhysicalDamageMonthly   Decimal? @map("insurance_physical_damage_monthly") @db.Decimal(12, 2)
  insuranceCargoMonthly            Decimal? @map("insurance_cargo_monthly") @db.Decimal(12, 2)
  insuranceGeneralLiabilityMonthly Decimal? @map("insurance_general_liability_monthly") @db.Decimal(12, 2)
  insuranceOtherMonthly            Decimal? @map("insurance_other_monthly") @db.Decimal(12, 2)
  otherFixedMonthly                Decimal? @map("other_fixed_monthly") @db.Decimal(12, 2)
  truckReplacementMonthly          Decimal? @map("truck_replacement_monthly") @db.Decimal(12, 2)
  annualFixedCosts                 Decimal? @map("annual_fixed_costs") @db.Decimal(12, 2)
  hiredDriverHourlyRate            Decimal? @map("hired_driver_hourly_rate") @db.Decimal(8, 2)
  hiredDriverPayKind               String?  @map("hired_driver_pay_kind")
  hiredDriverRatePerMile           Decimal? @map("hired_driver_rate_per_mile") @db.Decimal(8, 4)
  laborBurdenPct                   Decimal? @map("labor_burden_pct") @db.Decimal(6, 4)
  carrierCutPct                    Decimal? @map("carrier_cut_pct") @db.Decimal(6, 4)
  selfEmploymentTaxPct             Decimal? @map("self_employment_tax_pct") @db.Decimal(6, 4)
  fscCutApplies                    String?  @map("fsc_cut_applies")
  factoringFeePct                  Decimal? @map("factoring_fee_pct") @db.Decimal(6, 4)
  detentionHourlyRate              Decimal? @map("detention_hourly_rate") @db.Decimal(8, 2)
  freeGraceMinutes                 Int?     @map("free_grace_minutes")
  dailyRevenueTarget               Decimal? @map("daily_revenue_target") @db.Decimal(12, 2)
  routeBaseMinimum                 Decimal? @map("route_base_minimum") @db.Decimal(12, 2)
  routeIncludedMiles               Decimal? @map("route_included_miles") @db.Decimal(12, 2)
  routeIncludedStops               Int?     @map("route_included_stops")
  routeOveragePerMile              Decimal? @map("route_overage_per_mile") @db.Decimal(8, 4)
  routeOveragePerStop              Decimal? @map("route_overage_per_stop") @db.Decimal(8, 2)
  hourlyTargetConfirmedAt          DateTime? @map("hourly_target_confirmed_at")
  createdAt                        DateTime @default(now()) @map("created_at")
  updatedAt                        DateTime @updatedAt @map("updated_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("cost_profiles")
}

model Load {
  id                            String    @id @default(cuid())
  workspaceId                   String    @map("workspace_id")
  vehicleId                     String?   @map("vehicle_id")
  channel                       String?
  brokerName                    String?   @map("broker_name")
  brokerMcNumber                String?   @map("broker_mc_number")
  originAddress                 String?   @map("origin_address")
  destinationAddress            String?   @map("destination_address")
  loadType                      String?   @map("load_type")
  trailerType                   String?   @map("trailer_type")
  pickupDeadheadMiles           Decimal   @default(0) @map("pickup_deadhead_miles") @db.Decimal(12, 4)
  loadedMiles                   Decimal   @default(0) @map("loaded_miles") @db.Decimal(12, 4)
  returnDeadheadMiles           Decimal   @default(0) @map("return_deadhead_miles") @db.Decimal(12, 4)
  quotedRevenue                 Decimal   @default(0) @map("quoted_revenue") @db.Decimal(12, 2)
  actualRevenue                 Decimal?  @map("actual_revenue") @db.Decimal(12, 2)
  fuelSurcharge                 Decimal?  @map("fuel_surcharge") @db.Decimal(12, 2)
  fuelSurchargeUnit             String?   @map("fuel_surcharge_unit")
  layoverPay                    Decimal?  @map("layover_pay") @db.Decimal(12, 2)
  tonuRevenue                   Decimal?  @map("tonu_revenue") @db.Decimal(12, 2)
  expenseFuelActual             Decimal   @default(0) @map("expense_fuel_actual") @db.Decimal(12, 2)
  expenseTolls                  Decimal   @default(0) @map("expense_tolls") @db.Decimal(12, 2)
  expenseMisc                   Decimal   @default(0) @map("expense_misc") @db.Decimal(12, 2)
  status                        String    @default("draft")
  scheduledDate                 DateTime? @map("scheduled_date")
  completedAt                   DateTime? @map("completed_at")
  cancelledAt                   DateTime? @map("cancelled_at")
  cancelReason                  String?   @map("cancel_reason")
  paymentTerms                  String?   @map("payment_terms")
  payTermsDays                  Int?      @map("pay_terms_days")
  isBackhaul                    Boolean   @default(false) @map("is_backhaul")
  stopsCount                    Int?      @map("stops_count")
  dockWaitMinutes               Int?      @map("dock_wait_minutes")
  factoringFeePct               Decimal?  @map("factoring_fee_pct") @db.Decimal(6, 4)
  insuranceRiderFlat            Decimal?  @map("insurance_rider_flat") @db.Decimal(12, 2)
  marketBenchmark               Decimal?  @map("market_benchmark") @db.Decimal(12, 4)
  quotedPickupDhMiles           Decimal?  @map("quoted_pickup_dh_miles") @db.Decimal(12, 4)
  quotedLoadedMiles             Decimal?  @map("quoted_loaded_miles") @db.Decimal(12, 4)
  quotedReturnDhMiles           Decimal?  @map("quoted_return_dh_miles") @db.Decimal(12, 4)
  loadNumber                    String?   @map("load_number")
  poNumber                      String?   @map("po_number")
  pickupNumbers                 Json?     @map("pickup_numbers")
  deliveryNumbers               Json?     @map("delivery_numbers")
  rateConPath                   String?   @map("rate_con_path")
  closedWithoutPod              Boolean?  @map("closed_without_pod")
  invoiceNumber                 String?   @map("invoice_number")
  invoicedAmount                Decimal?  @map("invoiced_amount") @db.Decimal(12, 2)
  paymentStatus                 String?   @map("payment_status")
  invoicedAt                    DateTime? @map("invoiced_at")
  paidAt                        DateTime? @map("paid_at")
  paidAmount                    Decimal?  @map("paid_amount") @db.Decimal(12, 2)
  // Cost snapshot frozen at accept (TrueLane v46-v48), so a later profile edit never rewrites a finished load.
  snapshotBaseFloorRpm          Decimal?  @map("snapshot_base_floor_rpm") @db.Decimal(8, 4)
  snapshotTotalInsuranceMonthly Decimal?  @map("snapshot_total_insurance_monthly") @db.Decimal(12, 2)
  snapshotEstimatedMonthlyMiles Decimal?  @map("snapshot_estimated_monthly_miles") @db.Decimal(12, 2)
  snapshotArchetype             String?   @map("snapshot_archetype")
  snapshotCarrierCutPct         Decimal?  @map("snapshot_carrier_cut_pct") @db.Decimal(6, 4)
  snapshotLaborCpm              Decimal?  @map("snapshot_labor_cpm") @db.Decimal(8, 4)
  snapshotMpg                   Decimal?  @map("snapshot_mpg") @db.Decimal(8, 3)
  snapshotFscCutApplies         Boolean?  @map("snapshot_fsc_cut_applies")
  snapshotDetentionRate         Decimal?  @map("snapshot_detention_rate") @db.Decimal(8, 2)
  snapshotFreeGraceMinutes      Int?      @map("snapshot_free_grace_minutes")
  createdAt                     DateTime  @default(now()) @map("created_at")
  updatedAt                     DateTime  @updatedAt @map("updated_at")
  deletedAt                     DateTime? @map("deleted_at")

  workspace  Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  vehicle    Vehicle?       @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  stops      Stop[]
  segments   TripSegment[]
  decisions  LoadDecision[]
  assignment Assignment?

  @@index([workspaceId, status])
  @@index([vehicleId])
  @@index([completedAt])
  @@map("loads")
}

model Stop {
  id                 String    @id @default(cuid())
  loadId             String    @map("load_id")
  stopSequence       Int       @map("stop_sequence")
  addressString      String    @map("address_string")
  lat                Decimal?  @db.Decimal(9, 6)
  lng                Decimal?  @db.Decimal(9, 6)
  stopType           String    @map("stop_type")
  stopRole           String?   @map("stop_role")
  referenceNumbers   Json?     @map("reference_numbers")
  timeWindowEarliest DateTime? @map("time_window_earliest")
  timeWindowLatest   DateTime? @map("time_window_latest")
  podPhotoUrl        String?   @map("pod_photo_url")
  facilityName       String?   @map("facility_name")
  contactName        String?   @map("contact_name")
  contactPhone       String?   @map("contact_phone")
  stopNotes          String?   @map("stop_notes")
  waitMinutes        Int?      @map("wait_minutes")
  arrivedAt          DateTime? @map("arrived_at")
  sealNumber         String?   @map("seal_number")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  load Load @relation(fields: [loadId], references: [id], onDelete: Cascade)

  @@index([loadId, stopSequence])
  @@map("stops")
}

model TripSegment {
  id               String    @id @default(cuid())
  loadId           String    @map("load_id")
  segmentType      String    @map("segment_type")
  miles            Decimal   @db.Decimal(12, 4)
  durationMinutes  Int?      @map("duration_minutes")
  fuelCost         Decimal?  @map("fuel_cost") @db.Decimal(12, 2)
  isManualOverride Boolean   @default(false) @map("is_manual_override")
  startedAt        DateTime? @map("started_at")
  endedAt          DateTime? @map("ended_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  load Load @relation(fields: [loadId], references: [id], onDelete: Cascade)

  @@index([loadId])
  @@map("trip_segments")
}

model LoadDecision {
  id             String   @id @default(cuid())
  loadId         String   @map("load_id")
  decisionType   String   @map("decision_type")
  overrideReason String?  @map("override_reason")
  overrideNotes  String?  @map("override_notes")
  decidedAt      DateTime @map("decided_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  load Load @relation(fields: [loadId], references: [id], onDelete: Cascade)

  @@index([loadId])
  @@map("load_decisions")
}

// ── Dispatcher layer (desktop-owned) ─────────────────────────────────────────────────────────

/// A driver the dispatcher can assign. TrueLane keeps its `drivers` table on the phone only.
model Driver {
  id                String    @id @default(cuid())
  workspaceId       String    @map("workspace_id")
  name              String
  phone             String?
  email             String?
  cdlClass          String?   @map("cdl_class")
  cdlExpiry         DateTime? @map("cdl_expiry")
  medicalCardExpiry DateTime? @map("medical_card_expiry")
  assignedVehicleId String?   @map("assigned_vehicle_id")
  /// What this driver is usually paid: cpm | hourly | flat, and the rate. An assignment starts from it; the assignment's own pay wins.
  defaultPayKind    String?   @map("default_pay_kind")
  defaultPayRate    Decimal?  @map("default_pay_rate") @db.Decimal(12, 4)
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  workspace       Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignedVehicle Vehicle?     @relation(fields: [assignedVehicleId], references: [id], onDelete: SetNull)
  assignments     Assignment[]

  @@index([workspaceId])
  @@map("drivers")
}

/// One driver and one pay per dispatched load (CONVERGENCE_BUILD_PLAN section 6). The pay shape is the bridge
/// contract's driver_pay: { kind: flat | cpm | hourly, rate }; `estimate` is display only.
/// status: draft | dispatched | accepted | declined | in_progress | completed.
model Assignment {
  id                String    @id @default(cuid())
  loadId            String    @unique @map("load_id")
  driverId          String    @map("driver_id")
  payKind           String    @map("pay_kind")
  payRate           Decimal   @map("pay_rate") @db.Decimal(12, 4)
  payEstimate       Decimal?  @map("pay_estimate") @db.Decimal(12, 2)
  status            String    @default("draft")
  assignmentVersion Int       @default(1) @map("assignment_version")
  driverResponse    Json?     @map("driver_response")
  dispatchedAt      DateTime? @map("dispatched_at")
  respondedAt       DateTime? @map("responded_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  load   Load   @relation(fields: [loadId], references: [id], onDelete: Cascade)
  driver Driver @relation(fields: [driverId], references: [id], onDelete: Restrict)

  @@index([driverId, status])
  @@map("assignments")
}

/// What the desk did and why: assignments, sends, driver answers, unassignments, invoices, payments and rate-confirmation
/// saves. `loadId` is a plain column (no foreign key) and `loadNumber` is copied in, so the trail outlives a deleted load.
/// `before` / `after` are small label-to-value objects shown as a diff; `reason` is the dispatcher's own words.
model AuditEvent {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  loadId      String?  @map("load_id")
  loadNumber  String?  @map("load_number")
  entity      String
  action      String
  summary     String
  reason      String?
  before      Json?
  after       Json?
  actor       String   @default("Dispatcher")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([loadId, createdAt])
  @@map("audit_events")
}
