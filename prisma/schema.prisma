generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  COORDINATOR
  REGIONAL_MANAGER
  CORPORATE_OPS
  ADMIN
}

enum FuelSurchargeSource {
  manual_tuesday
  manual_override
}

enum ParseState {
  UPLOADED
  QUEUED
  EXTRACTED
  FAILED_INVALID
  FAILED_TIMEOUT
  FAILED_SCHEMA
  FAILED_LOW_CONFIDENCE
}

enum DuplicateSignal {
  EXACT_DUPLICATE
  SOFT_DUPLICATE_WARNING
}

enum ReviewDecision {
  PENDING
  APPROVED
  REJECTED
}

enum BrokerOnboardingStatus {
  PENDING
  APPROVED
  BLOCKED
}

enum LoadStatus {
  BOOKED
  DISPATCHED
  PICKED_UP
  DELIVERED
  POD_RECEIVED
  COMPLETED
  CANCELED
  FAILED
}

enum TaskDoneStatus {
  NOT_DONE
  DONE
}

enum DeliveryExceptionState {
  NONE
  WORK_IN_REQUESTED
  RESCHEDULED
}

enum LineHaulPricingModel {
  FLAT
  FLAT_PLUS_FUEL
  OTHER
}

enum RuleSeverity {
  INFO
  WARN
  ACTION_REQUIRED
}

enum AttentionSeverity {
  INFO
  WARN
  URGENT
}

enum PuDelStatusPreset {
  ETA_TO_PU_DEL
  LOADED_SET_TO_DEL
  LATE
  DONE
  OTHER
  // Daily-Planner F-column work-queue states (the coordinator's action list).
  NEED_DRVR
  NEED_ETA_TO_PU
  NEED_ETA_TO_DEL
  NEED_DEL_DRVR
  NEED_RELAY_DRVR
  TRANSFER
  LOADED
}

enum DriverType {
  SHUTTLE
  PTP
  LTL
}

enum EquipmentType {
  BOX_TRUCK
  FLATBED_OR_STEPDECK
  VAN_48
  VAN_53
  OTHER
}

enum EquipmentAccessory {
  STRAPS
  TARPS
  CHAINS
  BARS
  NONE
  OTHER
}

enum PodStatusWorkflow {
  NOT_REQUESTED
  REQUESTED
  UPLOADED
  SENT_TO_BROKER
  NEEDS_ATTENTION
}

enum LoadLegType {
  SHUTTLE
  PTP
  DELIVERY
}

enum ApptType {
  FIRM_APPT
  OPEN_WINDOW
  FCFS
}

// ── Ops-analytics: disruption capture (cancels & reschedules) ────────────────
// A cancel or reschedule that needs an operator-supplied reason. Reasons cannot
// be backfilled, so this is captured at write time; weekIso is denormalized so
// the KPI breakdown can group without re-deriving it from the Load.
enum DisruptionKind {
  CANCEL
  RESCHEDULE
}

// The one shared 9-reason taxonomy used by the drawer, ConfirmDialog callers,
// copilot tools, and the Phase-3 breakdown.
enum DisruptionReason {
  CARRIER_NO_SHOW
  CARRIER_LATE_OR_NOT_EMPTY
  PARTY_RESCHEDULE
  NO_DOCK_TIME
  WEATHER_ROAD
  EQUIPMENT_ISSUE
  RATE_BILLING_DISPUTE
  LOAD_PULLED
  OTHER
}

model Region {
  id        String   @id @default(cuid())
  code      String   @unique @db.VarChar(4)
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  distributionCenters DistributionCenter[]
  dropLots            DropLot[]
  lanes               Lane[]
  brokers             Broker[]
  rateConfirmations   RateConfirmation[]
  loads               Load[]
  weekSnapshots       WeekSnapshot[]
  fuelSurchargeIndex  FuelSurchargeIndex[]
  operationalRules    OperationalRule[]
  userRegionRoles     UserRegionRole[]
  drivers             Driver[]
  directCustomers     DirectCustomer[]
  bookingPlanEntries  BookingPlanEntry[]
  disruptionEvents    LoadDisruptionEvent[]
  config              RegionConfig?
}

model DistributionCenter {
  id        String    @id @default(cuid())
  regionId  String
  name      String
  city      String
  state     String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  region Region @relation(fields: [regionId], references: [id], onDelete: Restrict)
}

model DropLot {
  id               String    @id @default(cuid())
  regionId         String
  name             String
  code             String?   @db.VarChar(12)
  note             String?
  city             String
  state            String
  sortOrder        Int       @default(0)
  dailyCapacity    Int?
  slipSeat         Boolean   @default(false)
  dropHookRequired Boolean   @default(false)
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  region      Region   @relation(fields: [regionId], references: [id], onDelete: Restrict)
  loads       Load[]
  homeDrivers Driver[]
}

model Lane {
  id               String    @id @default(cuid())
  regionId         String
  originCity       String
  originState      String
  destinationCity  String
  destinationState String
  targetRate       Decimal   @db.Decimal(12, 4)
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  region Region @relation(fields: [regionId], references: [id], onDelete: Restrict)

  @@unique([regionId, originCity, originState, destinationCity, destinationState])
}

model Broker {
  id                String                 @id @default(cuid())
  regionId          String
  name              String
  onboardingStatus  BrokerOnboardingStatus @default(PENDING)
  fscDefaultApplies Boolean                @default(true)
  deletedAt         DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  region             Region             @relation(fields: [regionId], references: [id], onDelete: Restrict)
  brokerReps         BrokerRep[]
  loads              Load[]
  bookingPlanEntries BookingPlanEntry[]
}

model BrokerRep {
  id        String    @id @default(cuid())
  brokerId  String
  name      String
  email     String?
  phone     String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  broker Broker @relation(fields: [brokerId], references: [id], onDelete: Restrict)
}

model RateConfirmation {
  id               String           @id @default(cuid())
  regionId         String
  weekIso          String
  sourceFileUrl    String
  sourceFileHash   String           @unique
  idempotencyKey   String?          @unique
  parseState       ParseState
  reviewDecision   ReviewDecision   @default(APPROVED)
  reviewedAt       DateTime?
  reviewedById     String?
  reviewReason     String?
  parseConfidence  Decimal?         @db.Decimal(5, 4)
  contractVersion  String?          @db.VarChar(16)
  duplicateSignal  DuplicateSignal?
  intakeDriverType DriverType?
  extractedPayload Json?
  deletedAt        DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  region Region @relation(fields: [regionId], references: [id], onDelete: Restrict)
  load   Load?

  @@index([regionId, weekIso])
}

model Load {
  id                        String                 @id @default(cuid())
  regionId                  String
  weekIso                   String
  pickupDate                DateTime
  status                    LoadStatus             @default(BOOKED)
  createdById               String
  dropLotId                 String?
  rateConfirmationId        String?                @unique
  brokerId                  String?
  // Direct-customer source (vs a broker) — powers booked-vs-expected cadence analytics.
  directCustomerId          String?
  bookingDate               DateTime?
  routeId                   String?
  loadNumber                String?
  pickupNumber              String?
  pickupNumbers             String[]               @default([])
  // Structured, labeled reference numbers off the rate con (PU#, PO#, BOL#, seal#, pro#,
  // unlabeled → OTHER). Master store; pickupNumber(s) are derived from the PU-kind entries.
  // Shape: Array<{ kind: string; value: string; source?: "RATE_CON" | "MANUAL" }>.
  referenceNumbers          Json?
  threePlRefNumber          String?
  eventCode                 String?
  mgStatus                  String?
  tmwStatus                 String?
  mgStatusTask              TaskDoneStatus         @default(NOT_DONE)
  tmwStatusTask             TaskDoneStatus         @default(NOT_DONE)
  scaleBeforeTask           TaskDoneStatus         @default(NOT_DONE)
  scaleAfterTask            TaskDoneStatus         @default(NOT_DONE)
  bolMatchTask              TaskDoneStatus         @default(NOT_DONE)
  pickupEtaAdvised          TaskDoneStatus         @default(NOT_DONE)
  pickupArrivalAdvised      TaskDoneStatus         @default(NOT_DONE)
  deliveryEtaAdvised        TaskDoneStatus         @default(NOT_DONE)
  deliveryArrivalAdvised    TaskDoneStatus         @default(NOT_DONE)
  deliveryExceptionState    DeliveryExceptionState @default(NONE)
  rescheduleDriverConfirmed TaskDoneStatus         @default(NOT_DONE)
  // Booking/paperwork gates — the coordinator's three "did the paperwork land" checkboxes
  // (from his booking-log: Rate Con / Receipt / MG Rate Updated). Distinct from mgStatusTask.
  rateConReceived           TaskDoneStatus         @default(NOT_DONE)
  receiptReceived           TaskDoneStatus         @default(NOT_DONE)
  mgRateUpdated             TaskDoneStatus         @default(NOT_DONE)
  puStatusPreset            PuDelStatusPreset      @default(OTHER)
  puStatusCustom            String?
  delStatusPreset           PuDelStatusPreset      @default(OTHER)
  delStatusCustom           String?
  attentionSeverity         AttentionSeverity      @default(INFO)
  attentionNote             String?
  coordinatorNotes          String?
  driverType                DriverType?
  pickupDriverAssigned      String?
  pickupDriverId            String?
  tractorTrailer1           String?
  tractorTrailer2           String?
  commodity                 String?
  equipmentNeeds            String?
  equipmentType             EquipmentType?
  equipmentAccessory        EquipmentAccessory?
  equipmentOtherText        String?
  lumperFeeAmount           Decimal?               @db.Decimal(12, 4)
  shipperName               String?
  pickupCity                String?
  pickupState               String?
  pickupWindow              String?
  pickupApptType            ApptType?
  pickupWindowStart         DateTime?
  pickupWindowEnd           DateTime?
  pickupTimeZone            String?
  deliveryDriver            String?
  deliveryDriverId          String?
  receiverName              String?
  deliveryCity              String?
  deliveryState             String?
  deliveryWindow            String?
  deliveryApptType          ApptType?
  deliveryWindowStart       DateTime?
  deliveryWindowEnd         DateTime?
  deliveryTimeZone          String?
  deliveryDate              DateTime?
  podStatus                 PodStatusWorkflow?
  lineHaulRate              Decimal                @db.Decimal(12, 4)
  // DAT market rate benchmark for this load's lane, snapshotted at book time (defaults from
  // the lane's datRates value) and overridable per-load. Drives KPI "vs Market" variance.
  marketRate                Decimal?               @db.Decimal(12, 4)
  loadedMiles               Decimal                @db.Decimal(12, 4)
  puDeadheadMiles           Decimal                @db.Decimal(12, 4)
  delDeadheadMiles          Decimal                @db.Decimal(12, 4)
  fscApplies                Boolean
  fscRateUsed               Decimal?               @db.Decimal(12, 4)
  fscAmount                 Decimal                @default(0) @db.Decimal(12, 4)
  lineHaulPricingModel      LineHaulPricingModel   @default(FLAT)
  isTONU                    Boolean                @default(false)
  tonuAmount                Decimal                @default(0) @db.Decimal(12, 4)
  allInRevenue              Decimal                @default(0) @db.Decimal(12, 4)
  totalTripMiles            Decimal?               @db.Decimal(12, 4)
  negotiableMiles           Decimal?               @db.Decimal(12, 4)
  loadedRpm                 Decimal?               @db.Decimal(12, 4)
  emptyMilePct              Decimal?               @db.Decimal(8, 4)
  deletedAt                 DateTime?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  region            Region                @relation(fields: [regionId], references: [id], onDelete: Restrict)
  createdBy         User                  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  dropLot           DropLot?              @relation(fields: [dropLotId], references: [id], onDelete: SetNull)
  rateConfirmation  RateConfirmation?     @relation(fields: [rateConfirmationId], references: [id], onDelete: SetNull)
  broker            Broker?               @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  directCustomer    DirectCustomer?       @relation(fields: [directCustomerId], references: [id], onDelete: SetNull)
  pickupDriverRef   Driver?               @relation("LoadPickupDriver", fields: [pickupDriverId], references: [id], onDelete: SetNull)
  deliveryDriverRef Driver?               @relation("LoadDeliveryDriver", fields: [deliveryDriverId], references: [id], onDelete: SetNull)
  legs              LoadLeg[]
  bookingPlanEntry  BookingPlanEntry?
  disruptionEvents  LoadDisruptionEvent[]

  @@index([regionId, weekIso])
  @@index([bookingDate])
  @@index([regionId, dropLotId, bookingDate])
  @@index([pickupDriverId])
  @@index([deliveryDriverId])
  @@index([brokerId])
  @@index([directCustomerId])
}

model LoadLeg {
  id                   String         @id @default(cuid())
  loadId               String
  legIndex             Int
  legType              LoadLegType
  driverName           String?
  driverId             String?
  startCity            String?
  startState           String?
  endCity              String?
  endState             String?
  legMiles             Decimal?       @db.Decimal(12, 4)
  notes                String?
  etaAt                DateTime?
  arrivalAt            DateTime?
  // Trailer custody: the trailer # carried on this leg, and a confirmation that
  // the next driver hooked the correct trailer at the handoff into this leg.
  trailer              String?
  trailerHookConfirmed TaskDoneStatus @default(NOT_DONE)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  load   Load    @relation(fields: [loadId], references: [id], onDelete: Cascade)
  driver Driver? @relation(fields: [driverId], references: [id], onDelete: SetNull)

  @@index([loadId, legIndex])
  @@index([driverId])
}

model LoadDisruptionEvent {
  id       String           @id @default(cuid())
  loadId   String
  regionId String
  weekIso  String
  kind     DisruptionKind
  reason   DisruptionReason
  detail   String?
  actorId  String
  at       DateTime         @default(now())

  load   Load   @relation(fields: [loadId], references: [id], onDelete: Cascade)
  region Region @relation(fields: [regionId], references: [id], onDelete: Restrict)

  @@index([regionId, weekIso, kind])
  @@index([loadId])
}

model WeekSnapshot {
  id                    String    @id @default(cuid())
  regionId              String
  weekIso               String
  loadCount             Int       @default(0)
  lineHaulRevenue       Decimal   @default(0) @db.Decimal(12, 4)
  totalAllInRevenue     Decimal   @default(0) @db.Decimal(12, 4)
  totalTonuAmount       Decimal   @default(0) @db.Decimal(12, 4)
  fuelSurchargeAmount   Decimal   @default(0) @db.Decimal(12, 4)
  totalLoadedMiles      Decimal   @default(0) @db.Decimal(12, 4)
  totalPickupDeadhead   Decimal   @default(0) @db.Decimal(12, 4)
  totalDeliveryDeadhead Decimal   @default(0) @db.Decimal(12, 4)
  totalEmptyMiles       Decimal   @default(0) @db.Decimal(12, 4)
  totalTripMiles        Decimal   @default(0) @db.Decimal(12, 4)
  inboundRevenue        Decimal   @default(0) @db.Decimal(12, 4)
  inboundLoadedMiles    Decimal   @default(0) @db.Decimal(12, 4)
  emptyMilePct          Decimal?  @db.Decimal(8, 4)
  mileMaxMissingInbound Boolean   @default(true)
  mileMaxRpm            Decimal?  @db.Decimal(12, 4)
  laneIssueNotes        Json?
  computedAt            DateTime  @default(now())
  lockedAt              DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  region Region @relation(fields: [regionId], references: [id], onDelete: Restrict)

  @@unique([regionId, weekIso])
}

model FuelSurchargeIndex {
  id              String              @id @default(cuid())
  regionId        String
  weekIso         String
  value           Decimal             @db.Decimal(12, 4)
  source          FuelSurchargeSource
  effectiveAt     DateTime
  updatedByUserId String
  updateReason    String
  updatedAt       DateTime            @updatedAt
  createdAt       DateTime            @default(now())

  region        Region @relation(fields: [regionId], references: [id], onDelete: Restrict)
  updatedByUser User   @relation(fields: [updatedByUserId], references: [id], onDelete: Restrict)

  @@index([regionId, weekIso, source])
  @@index([regionId, weekIso, effectiveAt(sort: Desc)])
}

model OperationalRule {
  id        String       @id @default(cuid())
  regionId  String
  code      String
  severity  RuleSeverity
  statement String
  metadata  Json?
  deletedAt DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  region Region @relation(fields: [regionId], references: [id], onDelete: Restrict)

  @@unique([regionId, code])
}

model User {
  id              String               @id
  email           String               @unique
  name            String?
  deletedAt       DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  userRegionRoles UserRegionRole[]
  loadsCreated    Load[]
  fscUpdates      FuelSurchargeIndex[]
}

model UserRegionRole {
  id        String   @id @default(cuid())
  userId    String
  regionId  String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  region Region @relation(fields: [regionId], references: [id], onDelete: Restrict)

  @@unique([userId, regionId])
}

model AuditLog {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  action      String
  actorId     String
  timestamp   DateTime @default(now())
  reason      String?
  beforeValue Json?
  afterValue  Json?

  @@index([entityType, entityId, timestamp])
  @@index([timestamp])
}

// Singleton row (id == "default") holding the active LLM provider configuration.
// The API key is stored AES-256-GCM encrypted in `apiKeyCipher`; `apiKeyLast4` is
// kept only for masked display. The raw key is never persisted in plaintext.
model LlmProviderConfig {
  id           String   @id @default("default")
  provider     String
  model        String
  // Model used by the conversational copilot (tool-use); defaults to a stronger
  // model than the parser when unset. Same provider/key as `model`.
  copilotModel String?
  apiKeyCipher String?
  apiKeyLast4  String?
  isActive     Boolean  @default(true)
  updatedById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// DAT market-rate API credentials. Same AES-256-GCM at-rest pattern as
// LlmProviderConfig: `apiKeyCipher` encrypted, `apiKeyLast4` for masked display,
// raw key never persisted. Singleton (id "default"), global. Not yet wired to a
// live DAT API — the key is stored so manual market rates can be swapped for the
// API later without a settings migration.
model DatProviderConfig {
  id           String   @id @default("default")
  apiKeyCipher String?
  apiKeyLast4  String?
  isActive     Boolean  @default(true)
  updatedById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ── Market Variance: live DAT lane rates + negotiation tracker ───────────────
// DAT iQ / RateView benchmark rates cached per lane, plus a persisted log of how
// each negotiated backhaul rate compared to market at booking time. We are the
// CARRIER, so the negotiated rate is REVENUE: above market is good (ABOVE = 🟢).
// Reference ids are stored as plain scalars (no FK) so this cache + append-only
// log never cascades from, or blocks deletion of, loads/brokers/customers.

enum DatEquipment {
  VAN
  REEFER
  FLATBED
}

enum DatRateType {
  SPOT
  CONTRACT
}

enum MarketPerformanceBand {
  ABOVE // negotiated beats market by >10% (good for us)
  AT    // within ±10% of market
  BELOW // negotiated trails market by >10% (review / renegotiate)
}

// A cached DAT lane-rate lookup. Refreshed on demand; `fetchedAt` drives staleness
// so the UI shows an "as-of" time + refresh affordance without re-billing DAT on
// every keystroke. Rate figures are per-mile (DAT-native); `mileage` is DAT's
// practical road miles when the API returns them.
model MarketRateQuote {
  id              String       @id @default(cuid())
  regionId        String
  originCity      String
  originState     String
  destCity        String
  destState       String
  equipment       DatEquipment
  rateType        DatRateType
  ratePerMileLow  Decimal      @db.Decimal(12, 4)
  ratePerMileAvg  Decimal      @db.Decimal(12, 4)
  ratePerMileHigh Decimal      @db.Decimal(12, 4)
  fuelPerMile     Decimal?     @db.Decimal(12, 4)
  mileage         Decimal?     @db.Decimal(12, 4)
  reportCount     Int?
  timeframe       String?
  source          String // "dat" | "mock"
  raw             Json?
  fetchedAt       DateTime     @default(now())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([regionId, originCity, originState, destCity, destState, equipment, rateType])
  @@index([regionId, fetchedAt])
}

// One logged negotiation: the market snapshot at booking time + our negotiated rate,
// with the variance frozen so history stays accurate as the market moves. Positive
// variance = negotiated above market = revenue win.
model MarketVarianceEntry {
  id                String                @id @default(cuid())
  regionId          String
  createdById       String
  originCity        String
  originState       String
  destCity          String
  destState         String
  equipment         DatEquipment
  rateType          DatRateType
  negotiatedTotal   Decimal               @db.Decimal(12, 4)
  negotiatedPerMile Decimal               @db.Decimal(12, 4)
  miles             Decimal               @db.Decimal(12, 4)
  milesSource       String // "dat" | "google" | "manual"
  marketPerMile     Decimal               @db.Decimal(12, 4)
  marketTotal       Decimal               @db.Decimal(12, 4)
  variancePerMile   Decimal               @db.Decimal(12, 4)
  varianceTotal     Decimal               @db.Decimal(12, 4)
  variancePct       Decimal               @db.Decimal(9, 4)
  band              MarketPerformanceBand
  loadId            String?
  brokerId          String?
  directCustomerId  String?
  quoteId           String?
  notes             String?
  createdAt         DateTime              @default(now())

  @@index([regionId, createdAt])
}

// Per-region board tunables (e.g. Empty% color thresholds). Editable on the Settings
// page and via the copilot. Singleton per region (regionId unique).
model RegionConfig {
  id              String   @id @default(cuid())
  regionId        String   @unique
  emptyPctAmber   Decimal  @default(15) @db.Decimal(5, 2)
  emptyPctRed     Decimal  @default(25) @db.Decimal(5, 2)
  emptyPctAlert   Decimal  @default(6.5) @db.Decimal(5, 2)
  onTimeTargetPct Decimal  @default(95) @db.Decimal(5, 2)
  // ± band (whole percent) around DAT market that counts as "at market" before a
  // negotiation is flagged above/below. Drives the Market Variance module + tracker.
  marketVarianceBandPct Decimal @default(10) @db.Decimal(5, 2)
  updatedById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  region Region @relation(fields: [regionId], references: [id], onDelete: Restrict)

  @@index([regionId])
}

// ── Phase 1: Driver & DirectCustomer reference entities ─────────────────────

// Roster attributes / certifications from the Daily Booking Plan tab.
enum DriverAttribute {
  LTL_CERT
  SLEEPER
  TURNS_ONLY
  DEDICATED
  REGIONAL
  FLEX
  SHUTTLE
  PTP
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum CadencePeriod {
  DAY
  WEEK
}

// A rostered driver (previously free text on Load/LoadLeg). `code` is the short
// roster handle ("REES2"); the weekly availability is a flat day-set + local
// start time so one row stays one editable roster line.
model Driver {
  id               String            @id @default(cuid())
  regionId         String
  code             String            @db.VarChar(16)
  fullName         String
  phone            String?
  homeDropLotId    String?
  active           Boolean           @default(true)
  attributes       DriverAttribute[] @default([])
  scheduleDays     DayOfWeek[]       @default([])
  // Local wall-clock start, "HH:MM" 24h (recurring time, not an instant).
  scheduleStart    String?           @db.VarChar(5)
  // IANA zone; null = region default.
  scheduleTimeZone String?
  scheduleNote     String?
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  region             Region             @relation(fields: [regionId], references: [id], onDelete: Restrict)
  homeDropLot        DropLot?           @relation(fields: [homeDropLotId], references: [id], onDelete: SetNull)
  pickupLoads        Load[]             @relation("LoadPickupDriver")
  deliveryLoads      Load[]             @relation("LoadDeliveryDriver")
  legs               LoadLeg[]
  bookingPlanEntries BookingPlanEntry[]

  @@unique([regionId, code])
  @@index([regionId, active])
}

// Direct customers with guaranteed recurring backhaul freight used to pre-stage
// trailers (e.g. SEALED AIR 1/DAY, AB 10/WEEK). Cadence is nullable as a pair —
// some customers have no stated cadence.
model DirectCustomer {
  id            String         @id @default(cuid())
  regionId      String
  name          String
  cadenceCount  Int?
  cadencePeriod CadencePeriod?
  notes         String?
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  region Region @relation(fields: [regionId], references: [id], onDelete: Restrict)
  loads  Load[]

  @@index([regionId])
}

enum BookingPlanStatus {
  NEEDS_BACKHAUL
  SOURCING
  BOOKED
}

// One line of the Daily Booking Plan: a rostered driver expected to run empty
// on `planDate`, where/when they go empty, and the sourcing shorthand until a
// real Load exists. Mirrors the sheet's working header (EMPTY CITY / EMPTY
// CITY2 / BACKHAUL / PU CITY & DH / PU TIMES / DEL CITY & DH / DEL TIMES /
// STATUS). planDate is a true DATE column — date-only semantics by type.
model BookingPlanEntry {
  id              String            @id @default(cuid())
  regionId        String
  planDate        DateTime          @db.Date
  driverId        String
  // Local wall-clock "HH:MM", same convention as Driver.scheduleStart.
  expectedEmptyAt String?           @db.VarChar(5)
  emptyCity       String?
  emptyState      String?
  // The sheet's "EMPTY CITY2" — secondary/alternate empty location.
  emptyCityAlt    String?
  // Free-text freight being sourced (sheet "BACKHAUL").
  backhaulNote    String?
  status          BookingPlanStatus @default(NEEDS_BACKHAUL)
  // Sourcing detail captured while working the entry, carried onto the Load at Book time
  // (the booking-log's Broker + Amount) so booking no longer creates a Load at rate 0.
  brokerId        String?
  bookedAmount    Decimal?          @db.Decimal(12, 4)
  sourcedLoadId   String?           @unique
  // Planner shorthand before a Load exists (sheet columns, kept as strings).
  puCityDh        String?
  puTimes         String?
  delCityDh       String?
  delTimes        String?
  deletedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  region      Region  @relation(fields: [regionId], references: [id], onDelete: Restrict)
  driver      Driver  @relation(fields: [driverId], references: [id], onDelete: Restrict)
  broker      Broker? @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  sourcedLoad Load?   @relation(fields: [sourcedLoadId], references: [id], onDelete: SetNull)

  @@index([regionId, planDate])
  @@index([driverId])
}
