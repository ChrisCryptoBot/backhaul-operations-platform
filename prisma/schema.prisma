generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════════════════════════
// TrueLane-shaped models (the demo's source of truth).
//
// These mirror TrueLane's `db/schema.ts` (WatermelonDB v56 / the synced Supabase tables): the same table
// and column names, snake_case in the database, camelCase here. Times are timestamptz here (the phone stores
// ms). The dispatcher layer (drivers, assignments) sits on top and is desktop-owned, as in the bridge
// contract (docs/CONVERGENCE_BUILD_PLAN.md): assignment is desktop-owned, execution is mobile-owned.
//
// The model names are TrueLane's own (the @@map table names match its tables). The old coordinator-task models
// (regions, weeks, drop lots, per-load task checklists and the rest) were dropped in 20261028010000.
// Status values are plain strings, as on the phone: draft | accepted | in_progress | completed | tonu | cancelled.
// ═══════════════════════════════════════════════════════════════════════════════════════════

/// The single demo workspace. Tenancy seam: TrueLane's user_id / Clerk org id lands here later.
model Workspace {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  // Desk thresholds. Null means "use the default" (src/lib/thresholds.ts), so a fresh workspace needs no setup.
  emptyAmberPct         Decimal? @map("empty_amber_pct") @db.Decimal(5, 2)
  emptyRedPct           Decimal? @map("empty_red_pct") @db.Decimal(5, 2)
  defaultPayTermsDays   Int?     @map("default_pay_terms_days")
  detentionGraceMinutes Int?     @map("detention_grace_minutes")
  alertPickupHours      Int?     @map("alert_pickup_hours")
  alertSentHours        Int?     @map("alert_sent_hours")
  alertClearanceDays    Int?     @map("alert_clearance_days")
  laneMinLoads          Int?     @map("lane_min_loads")
  laneDays              Int?     @map("lane_days")
  /// Trailer dwell: hours an unhooked trailer may sit before it is a dwell alert, and the per-day charge after that. Null = the built-in default (48 hours, $75 a day); the company's figure wins, a person's typed figure on a trailer wins over both.
  dwellFreeHours        Int?     @map("dwell_free_hours")
  dwellPerDayRate       Decimal? @map("dwell_per_day_rate") @db.Decimal(8, 2)
  /// The last statement number given out, so a discarded draft's number is never given again.
  settlementSeq         Int      @default(0) @map("settlement_seq")

  // The company as it appears on invoices and driver statements. All optional: a sheet prints only what is filled in.
  mcNumber    String? @map("mc_number")
  dotNumber   String? @map("dot_number")
  address     String?
  phone       String?
  email       String?
  /// Where a broker sends the payment (a bank, a factor, a lockbox), printed on the invoice.
  remitTo     String? @map("remit_to")
  paymentNote String? @map("payment_note")

  /// The plan the workspace is on (starter | growth | pro | enterprise). A missing plan is read as Starter (src/lib/plans.ts effectivePlan), never as "no limit".
  plan               String?             @default("starter")
  /// The carrier's own clock (an IANA zone such as America/New_York): where billing days, aging, weekly driver limits, statement weeks and "this month" are counted. Stops keep their own
  /// local time (an appointment at a facility is read in the facility's zone); see src/lib/tz.ts. New workspaces start on Central, as the desk always has.
  timezone           String              @default("America/Chicago") @map("timezone")
  /// The driver link (docs/DRIVER_LINK_DESIGN.md): the Clerk Organization this workspace is mapped to on the bridge (null = not bridged: the dispatcher records the driver's answers), and the
  /// last `sync_seq` of the bridge table read, so each pull continues where the last one ended.
  bridgeOrgId        String?             @map("bridge_org_id")
  bridgeCursor       BigInt              @default(0) @map("bridge_cursor")
  partnerConnections PartnerConnection[]
  bridgeOutbox       BridgeOutbox[]
  partnerCredentials PartnerCredential[]
  partnerEvents      PartnerEvent[]
  iftaLines          IftaLine[]
  fuelTransactions   FuelTransaction[]
  vehiclePings       VehiclePing[]
  checkCalls         CheckCall[]
  unitStays          UnitStay[]
  trailerMoves       TrailerMove[]
  terminals          Terminal[]
  regions            Region[]
  laneTargets        LaneTarget[]
  kpiNotes           KpiNote[]
  importedHistory    ImportedHistory[]
  driverSchedules    DriverSchedule[]
  driverTimeOff      DriverShiftException[]
  members            Member[]
  threads            Thread[]
  vehicles           Vehicle[]
  trailers           Trailer[]
  loads              Load[]
  drivers            Driver[]
  auditEvents        AuditEvent[]
  settlements        Settlement[]
  customers          Customer[]

  @@map("workspaces")
}

/// Who a load is for: a broker, a shipper or a direct customer. A load keeps its customer's name as text, so this is the profile attached to that
/// name (kind, MC for a broker or carrier, billing contact, default pay terms, notes) rather than something every load points at.
model Customer {
  id                  String   @id @default(cuid())
  workspaceId         String   @map("workspace_id")
  name                String
  /// broker, shipper or other.
  kind                String   @default("broker")
  mcNumber            String?  @map("mc_number")
  contactName         String?  @map("contact_name")
  contactEmail        String?  @map("contact_email")
  contactPhone        String?  @map("contact_phone")
  /// Used for an invoice to this customer when the load names no terms of its own.
  defaultPayTermsDays Int?     @map("default_pay_terms_days")
  notes               String?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("customers")
}

model Vehicle {
  id                String    @id @default(cuid())
  workspaceId       String    @map("workspace_id")
  name              String?
  make              String?
  model             String?
  year              Int?
  type              String?
  mpg               Decimal?  @db.Decimal(8, 3)
  fuelType          String?   @map("fuel_type")
  homeBaseAddress   String?   @map("home_base_address")
  /// Where the home base is, found once (permanent geocoding) so measuring a quote does not look the address up each time. Blank until it is found.
  homeBaseLat       Decimal?  @map("home_base_lat") @db.Decimal(9, 6)
  homeBaseLng       Decimal?  @map("home_base_lng") @db.Decimal(9, 6)
  payloadLbs        Int?      @map("payload_lbs")
  maxLengthFt       Decimal?  @map("max_length_ft") @db.Decimal(8, 2)
  maxWidthFt        Decimal?  @map("max_width_ft") @db.Decimal(8, 2)
  maxHeightIn       Decimal?  @map("max_height_in") @db.Decimal(8, 2)
  /// What the truck carries for loads that need it. Unticked reads as "not equipped", as on the phone.
  hasLiftgate       Boolean   @default(false) @map("has_liftgate")
  hasRamp           Boolean   @default(false) @map("has_ramp")
  hasPalletJack     Boolean   @default(false) @map("has_pallet_jack")
  /// Which terminal (yard, branch, region) runs this truck. Free text; the terminals offered are the distinct values in use. Blank = unassigned.
  terminal          String?
  /// The ELD the tractor is linked to and the hours left on the driver's clock as it last reported them (a caution on the Quote, never a rule).
  eldProvider       String    @default("none") @map("eld_provider")
  eldVehicleId      String?   @map("eld_vehicle_id")
  hosAvailableHours Decimal?  @map("hos_available_hours") @db.Decimal(5, 2)
  hosSyncedAt       DateTime? @map("hos_synced_at")
  /// Where the ELD last put the tractor, and when it said so. Shown as 'last seen'; never an input to a verdict.
  lastLat           Decimal?  @map("last_lat") @db.Decimal(9, 6)
  lastLng           Decimal?  @map("last_lng") @db.Decimal(9, 6)
  lastLocatedAt     DateTime? @map("last_located_at")
  /// What the ELD said about the engine at that fix: speed, heading, moving / idle / off, hours idle today, and when the current idle began. Written only by the ELD sync.
  vin               String?
  lastSpeedMph      Decimal?  @map("last_speed_mph") @db.Decimal(5, 1)
  lastHeadingDeg    Int?      @map("last_heading_deg")
  engineState       String?   @map("engine_state")
  idleHoursToday    Decimal?  @map("idle_hours_today") @db.Decimal(5, 2)
  idleSince         DateTime? @map("idle_since")
  active            Boolean   @default(true)
  archivedAt        DateTime? @map("archived_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  costProfile      CostProfile?
  loads            Load[]
  drivers          Driver[]
  trailers         Trailer[]
  pings            VehiclePing[]
  checkCalls       CheckCall[]
  stays            UnitStay[]
  trailerMoves     TrailerMove[]
  fuelTransactions FuelTransaction[]

  @@index([workspaceId, archivedAt, name])
  @@index([workspaceId, terminal])
  @@map("vehicles")
}

/// One per vehicle. Inputs to TrueLane's break-even floor (src/truelane/lib/domain/calculators.ts computeCostProfileFloorBreakdown).
model CostProfile {
  id                               String    @id @default(cuid())
  vehicleId                        String    @unique @map("vehicle_id")
  monthlyInsurance                 Decimal   @default(0) @map("monthly_insurance") @db.Decimal(12, 2)
  monthlyAuthority                 Decimal   @default(0) @map("monthly_authority") @db.Decimal(12, 2)
  monthlyPhoneSubscriptions        Decimal   @default(0) @map("monthly_phone_subscriptions") @db.Decimal(12, 2)
  monthlyLoanPayment               Decimal   @default(0) @map("monthly_loan_payment") @db.Decimal(12, 2)
  estimatedMonthlyMiles            Decimal   @map("estimated_monthly_miles") @db.Decimal(12, 2)
  maintenanceReservePerMile        Decimal   @default(0) @map("maintenance_reserve_per_mile") @db.Decimal(8, 4)
  tireReservePerMile               Decimal   @default(0) @map("tire_reserve_per_mile") @db.Decimal(8, 4)
  driverHourlyTarget               Decimal   @default(0) @map("driver_hourly_target") @db.Decimal(8, 2)
  lastFuelPricePerGallon           Decimal?  @map("last_fuel_price_per_gallon") @db.Decimal(6, 3)
  breakEvenRpm                     Decimal   @map("break_even_rpm") @db.Decimal(8, 4)
  survivalFloorRpm                 Decimal?  @map("survival_floor_rpm") @db.Decimal(8, 4)
  archetype                        String?
  insuranceLiabilityMonthly        Decimal?  @map("insurance_liability_monthly") @db.Decimal(12, 2)
  insurancePhysicalDamageMonthly   Decimal?  @map("insurance_physical_damage_monthly") @db.Decimal(12, 2)
  insuranceCargoMonthly            Decimal?  @map("insurance_cargo_monthly") @db.Decimal(12, 2)
  insuranceGeneralLiabilityMonthly Decimal?  @map("insurance_general_liability_monthly") @db.Decimal(12, 2)
  insuranceOtherMonthly            Decimal?  @map("insurance_other_monthly") @db.Decimal(12, 2)
  otherFixedMonthly                Decimal?  @map("other_fixed_monthly") @db.Decimal(12, 2)
  truckReplacementMonthly          Decimal?  @map("truck_replacement_monthly") @db.Decimal(12, 2)
  annualFixedCosts                 Decimal?  @map("annual_fixed_costs") @db.Decimal(12, 2)
  hiredDriverHourlyRate            Decimal?  @map("hired_driver_hourly_rate") @db.Decimal(8, 2)
  hiredDriverPayKind               String?   @map("hired_driver_pay_kind")
  hiredDriverRatePerMile           Decimal?  @map("hired_driver_rate_per_mile") @db.Decimal(8, 4)
  laborBurdenPct                   Decimal?  @map("labor_burden_pct") @db.Decimal(6, 4)
  carrierCutPct                    Decimal?  @map("carrier_cut_pct") @db.Decimal(6, 4)
  selfEmploymentTaxPct             Decimal?  @map("self_employment_tax_pct") @db.Decimal(6, 4)
  fscCutApplies                    String?   @map("fsc_cut_applies")
  factoringFeePct                  Decimal?  @map("factoring_fee_pct") @db.Decimal(6, 4)
  detentionHourlyRate              Decimal?  @map("detention_hourly_rate") @db.Decimal(8, 2)
  freeGraceMinutes                 Int?      @map("free_grace_minutes")
  dailyRevenueTarget               Decimal?  @map("daily_revenue_target") @db.Decimal(12, 2)
  routeBaseMinimum                 Decimal?  @map("route_base_minimum") @db.Decimal(12, 2)
  routeIncludedMiles               Decimal?  @map("route_included_miles") @db.Decimal(12, 2)
  routeIncludedStops               Int?      @map("route_included_stops")
  routeOveragePerMile              Decimal?  @map("route_overage_per_mile") @db.Decimal(8, 4)
  routeOveragePerStop              Decimal?  @map("route_overage_per_stop") @db.Decimal(8, 2)
  hourlyTargetConfirmedAt          DateTime? @map("hourly_target_confirmed_at")
  createdAt                        DateTime  @default(now()) @map("created_at")
  updatedAt                        DateTime  @updatedAt @map("updated_at")

  vehicle           Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  /// The fuel card a truck buys its fuel on, and the account on it (a partner connection; blank until one is set up).
  fuelCardProvider  String? @map("fuel_card_provider")
  fuelCardAccountId String? @map("fuel_card_account_id")

  @@map("cost_profiles")
}

model Load {
  id                            String    @id @default(cuid())
  workspaceId                   String    @map("workspace_id")
  vehicleId                     String?   @map("vehicle_id")
  channel                       String?
  brokerName                    String?   @map("broker_name")
  brokerMcNumber                String?   @map("broker_mc_number")
  originAddress                 String?   @map("origin_address")
  destinationAddress            String?   @map("destination_address")
  loadType                      String?   @map("load_type")
  trailerType                   String?   @map("trailer_type")
  pickupDeadheadMiles           Decimal   @default(0) @map("pickup_deadhead_miles") @db.Decimal(12, 4)
  loadedMiles                   Decimal   @default(0) @map("loaded_miles") @db.Decimal(12, 4)
  returnDeadheadMiles           Decimal   @default(0) @map("return_deadhead_miles") @db.Decimal(12, 4)
  quotedRevenue                 Decimal   @default(0) @map("quoted_revenue") @db.Decimal(12, 2)
  actualRevenue                 Decimal?  @map("actual_revenue") @db.Decimal(12, 2)
  fuelSurcharge                 Decimal?  @map("fuel_surcharge") @db.Decimal(12, 2)
  fuelSurchargeUnit             String?   @map("fuel_surcharge_unit")
  layoverPay                    Decimal?  @map("layover_pay") @db.Decimal(12, 2)
  tonuRevenue                   Decimal?  @map("tonu_revenue") @db.Decimal(12, 2)
  expenseFuelActual             Decimal   @default(0) @map("expense_fuel_actual") @db.Decimal(12, 2)
  expenseTolls                  Decimal   @default(0) @map("expense_tolls") @db.Decimal(12, 2)
  expenseMisc                   Decimal   @default(0) @map("expense_misc") @db.Decimal(12, 2)
  status                        String    @default("draft")
  scheduledDate                 DateTime? @map("scheduled_date")
  completedAt                   DateTime? @map("completed_at")
  cancelledAt                   DateTime? @map("cancelled_at")
  cancelReason                  String?   @map("cancel_reason")
  paymentTerms                  String?   @map("payment_terms")
  payTermsDays                  Int?      @map("pay_terms_days")
  isBackhaul                    Boolean   @default(false) @map("is_backhaul")
  stopsCount                    Int?      @map("stops_count")
  dockWaitMinutes               Int?      @map("dock_wait_minutes")
  /// Drive time for the loaded miles as measured on the road when the load was quoted. Blank means the desk assumes 50 mph over every mile.
  estimatedLoadedHours          Decimal?  @map("estimated_loaded_hours") @db.Decimal(8, 2)
  /// What a saved quote keeps that a load has no column for: the fuel price and where it came from, each truck's measured or typed empty miles, which figures were typed by hand, and the driver picked.
  quoteExtras                   Json?     @map("quote_extras")
  factoringFeePct               Decimal?  @map("factoring_fee_pct") @db.Decimal(6, 4)
  insuranceRiderFlat            Decimal?  @map("insurance_rider_flat") @db.Decimal(12, 2)
  marketBenchmark               Decimal?  @map("market_benchmark") @db.Decimal(12, 4)
  quotedPickupDhMiles           Decimal?  @map("quoted_pickup_dh_miles") @db.Decimal(12, 4)
  quotedLoadedMiles             Decimal?  @map("quoted_loaded_miles") @db.Decimal(12, 4)
  quotedReturnDhMiles           Decimal?  @map("quoted_return_dh_miles") @db.Decimal(12, 4)
  loadNumber                    String?   @map("load_number")
  poNumber                      String?   @map("po_number")
  pickupNumbers                 Json?     @map("pickup_numbers")
  deliveryNumbers               Json?     @map("delivery_numbers")
  weightLbs                     Int?      @map("weight_lbs")
  lengthFt                      Decimal?  @map("length_ft") @db.Decimal(8, 2)
  widthFt                       Decimal?  @map("width_ft") @db.Decimal(8, 2)
  loadHeightIn                  Decimal?  @map("load_height_in") @db.Decimal(8, 2)
  hazmatClass                   String?   @map("hazmat_class")
  requiresLiftgate              Boolean?  @map("requires_liftgate")
  requiresRamp                  Boolean?  @map("requires_ramp")
  requiresPalletJack            Boolean?  @map("requires_pallet_jack")
  brokerPhone                   String?   @map("broker_phone")
  brokerEmail                   String?   @map("broker_email")
  notes                         String?
  /// What the proof of delivery is, or why there is none (closedWithoutPod). The file itself waits for the phone's storage.
  podNote                       String?   @map("pod_note")
  /// The invoice as billed, one entry per line: [{ label, amount }]. Its total is invoicedAmount.
  invoiceLines                  Json?     @map("invoice_lines")
  rateConPath                   String?   @map("rate_con_path")
  closedWithoutPod              Boolean?  @map("closed_without_pod")
  invoiceNumber                 String?   @map("invoice_number")
  invoicedAmount                Decimal?  @map("invoiced_amount") @db.Decimal(12, 2)
  paymentStatus                 String?   @map("payment_status")
  invoicedAt                    DateTime? @map("invoiced_at")
  paidAt                        DateTime? @map("paid_at")
  paidAmount                    Decimal?  @map("paid_amount") @db.Decimal(12, 2)
  /// What was written off when an invoice was closed short, and why: the money billed that will never come in, kept where revenue and cash can be reconciled.
  writeOffAmount                Decimal?  @map("write_off_amount") @db.Decimal(12, 2)
  writeOffReason                String?   @map("write_off_reason")
  /// What the trip cost, itemised: {lumper, scale, parking, lodging, wash, maintenance, permits, supplies}. expenseMisc stays the total of these and "other", so every sum that reads it is unchanged.
  expenseItems                  Json?     @map("expense_items")
  /// Why the revenue is what it is (a short pay, a detention the broker agreed to), in the dispatcher's words.
  revenueNote                   String?   @map("revenue_note")
  /// What the dispatcher wrote when the load was cancelled or turned into a TONU.
  cancelNote                    String?   @map("cancel_note")
  /// Miles driven on a load that became a TONU (the truck went and the load was not ready).
  tonuMiles                     Decimal?  @map("tonu_miles") @db.Decimal(12, 4)
  /// How the payment came in: ach, check, wire, card, factoring or other.
  paidMethod                    String?   @map("paid_method")
  // Cost snapshot frozen at accept (TrueLane v46-v48), so a later profile edit never rewrites a finished load.
  snapshotBaseFloorRpm          Decimal?  @map("snapshot_base_floor_rpm") @db.Decimal(8, 4)
  snapshotTotalInsuranceMonthly Decimal?  @map("snapshot_total_insurance_monthly") @db.Decimal(12, 2)
  snapshotEstimatedMonthlyMiles Decimal?  @map("snapshot_estimated_monthly_miles") @db.Decimal(12, 2)
  snapshotArchetype             String?   @map("snapshot_archetype")
  snapshotCarrierCutPct         Decimal?  @map("snapshot_carrier_cut_pct") @db.Decimal(6, 4)
  snapshotLaborCpm              Decimal?  @map("snapshot_labor_cpm") @db.Decimal(8, 4)
  snapshotMpg                   Decimal?  @map("snapshot_mpg") @db.Decimal(8, 3)
  snapshotFscCutApplies         Boolean?  @map("snapshot_fsc_cut_applies")
  snapshotDetentionRate         Decimal?  @map("snapshot_detention_rate") @db.Decimal(8, 2)
  snapshotFreeGraceMinutes      Int?      @map("snapshot_free_grace_minutes")
  createdAt                     DateTime  @default(now()) @map("created_at")
  updatedAt                     DateTime  @updatedAt @map("updated_at")
  deletedAt                     DateTime? @map("deleted_at")
  /// The trailer unit pulling this load (a record in the trailer registry). `trailerType` stays the kind of equipment the load needs.
  trailerId                     String?   @map("trailer_id")
  /// Where the invoice stands with a factor: none | requested | submitted | funded | rejected | paid.
  factoringStatus               String    @default("none") @map("factoring_status")
  factoringReferenceId          String?   @map("factoring_reference_id")
  factoringUpdatedAt            DateTime? @map("factoring_updated_at")
  /// Location sharing with a tracking network, for this load only (the carrier's yes each time): the link a customer follows, who it is with, and when it began. Cleared when sharing stops.
  trackingShareUrl              String?   @map("tracking_share_url")
  trackingProvider              String?   @map("tracking_provider")
  trackingSharedAt              DateTime? @map("tracking_shared_at")

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  vehicle          Vehicle?          @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  trailer          Trailer?          @relation(fields: [trailerId], references: [id], onDelete: SetNull)
  stops            Stop[]
  documents        LoadDocument[]
  fuelTransactions FuelTransaction[]
  payments         LoadPayment[]
  segments         TripSegment[]
  decisions        LoadDecision[]
  checkCalls       CheckCall[]
  assignment       Assignment?
  messages         Message[]
  settlement       SettlementLoad?

  // The lists a big fleet reads: by state, by day, by money, by customer, by number, and a truck's own loads. Trigram (search) indexes are in the
  // 20261106100000 migration only; Prisma cannot express them.
  @@index([workspaceId, deletedAt, status])
  @@index([workspaceId, scheduledDate])
  @@index([workspaceId, completedAt])
  @@index([workspaceId, paymentStatus])
  @@index([workspaceId, paymentStatus, invoicedAt])
  @@index([workspaceId, brokerName])
  @@index([workspaceId, loadNumber])
  @@index([vehicleId, status])
  @@index([trailerId])
  @@map("loads")
}

model Stop {
  id                 String    @id @default(cuid())
  loadId             String    @map("load_id")
  stopSequence       Int       @map("stop_sequence")
  addressString      String    @map("address_string")
  lat                Decimal?  @db.Decimal(9, 6)
  lng                Decimal?  @db.Decimal(9, 6)
  stopType           String    @map("stop_type")
  stopRole           String?   @map("stop_role")
  referenceNumbers   Json?     @map("reference_numbers")
  timeWindowEarliest DateTime? @map("time_window_earliest")
  timeWindowLatest   DateTime? @map("time_window_latest")
  podPhotoUrl        String?   @map("pod_photo_url")
  facilityName       String?   @map("facility_name")
  contactName        String?   @map("contact_name")
  contactPhone       String?   @map("contact_phone")
  stopNotes          String?   @map("stop_notes")
  waitMinutes        Int?      @map("wait_minutes")
  arrivedAt          DateTime? @map("arrived_at")
  sealNumber         String?   @map("seal_number")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  load Load @relation(fields: [loadId], references: [id], onDelete: Cascade)

  @@index([loadId, stopSequence])
  @@map("stops")
}

model TripSegment {
  id               String    @id @default(cuid())
  loadId           String    @map("load_id")
  segmentType      String    @map("segment_type")
  miles            Decimal   @db.Decimal(12, 4)
  durationMinutes  Int?      @map("duration_minutes")
  fuelCost         Decimal?  @map("fuel_cost") @db.Decimal(12, 2)
  isManualOverride Boolean   @default(false) @map("is_manual_override")
  startedAt        DateTime? @map("started_at")
  endedAt          DateTime? @map("ended_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  load Load @relation(fields: [loadId], references: [id], onDelete: Cascade)

  @@index([loadId])
  @@map("trip_segments")
}

model LoadDecision {
  id             String   @id @default(cuid())
  loadId         String   @map("load_id")
  decisionType   String   @map("decision_type")
  overrideReason String?  @map("override_reason")
  overrideNotes  String?  @map("override_notes")
  /// What the decision was made on, for the Quote decisions report: the verdict, what it was read against, the money, the first offer, the truck and the fuel price. Blank on decisions made before it was kept.
  details        Json?
  /// Who decided (the signed-in person, or "Dispatcher" with sign-in off).
  decidedBy      String?  @map("decided_by")
  decidedAt      DateTime @map("decided_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  load Load @relation(fields: [loadId], references: [id], onDelete: Cascade)

  @@index([loadId])
  @@map("load_decisions")
}

// ── Dispatcher layer (desktop-owned) ─────────────────────────────────────────────────────────

/// A driver the dispatcher can assign. TrueLane keeps its `drivers` table on the phone only.
model Driver {
  id                 String    @id @default(cuid())
  workspaceId        String    @map("workspace_id")
  name               String
  phone              String?
  email              String?
  cdlClass           String?   @map("cdl_class")
  cdlExpiry          DateTime? @map("cdl_expiry")
  medicalCardExpiry  DateTime? @map("medical_card_expiry")
  assignedVehicleId  String?   @map("assigned_vehicle_id")
  /// What this driver is usually paid: cpm | hourly | flat, and the rate. An assignment starts from it; the assignment's own pay wins.
  defaultPayKind     String?   @map("default_pay_kind")
  defaultPayRate     Decimal?  @map("default_pay_rate") @db.Decimal(12, 4)
  /// Which terminal (yard, branch, region) this driver works out of; the same free-text values as a truck's. Blank = unassigned.
  terminal           String?
  /// Payroll: the id the payroll company knows them by, whether they are an employee or a contractor, and whether they have been set up there (none | ready | sent | failed).
  payrollEmployeeId  String?   @map("payroll_employee_id")
  payrollStatus      String    @default("none") @map("payroll_status")
  payrollWorkerType  String?   @map("payroll_worker_type")
  /// The driver's own phone account (their Clerk user id on the bridge). Blank = no phone account: the dispatcher records their answers.
  phoneUserId        String?   @map("phone_user_id")
  /// The driver's id in the ELD, and the minutes left on each clock as it last reported them (drive, shift, 70-hour cycle). A caution, never a rule.
  eldDriverId        String?   @map("eld_driver_id")
  licenseNumber      String?   @map("license_number")
  hosDriveMinutes    Int?      @map("hos_drive_minutes")
  hosShiftMinutes    Int?      @map("hos_shift_minutes")
  hosCycleMinutes    Int?      @map("hos_cycle_minutes")
  hosSyncedAt        DateTime? @map("hos_synced_at")
  /// The carrier authority the driver (or their company) runs under, and what the last insurance check found.
  carrierMcNumber    String?   @map("carrier_mc_number")
  carrierDotNumber   String?   @map("carrier_dot_number")
  vetStatus          String    @default("unchecked") @map("vet_status")
  coiExpiresAt       DateTime? @map("coi_expires_at")
  vetCheckedAt       DateTime? @map("vet_checked_at")
  /// What the carrier check said besides its three words: the safety score (0 to 100), whether the operating authority is active, and the reasons it gave.
  vetSafetyScore     Int?      @map("vet_safety_score")
  vetAuthorityActive Boolean?  @map("vet_authority_active")
  vetFlags           Json?     @map("vet_flags")
  /// The driver's short code: first initial plus the first three letters of the last name (JSMI), a number on the end for a second driver who comes to the same one (JSMI2). Made once, never follows a rename.
  code               String?
  active             Boolean   @default(true)
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  workspace       Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignedVehicle Vehicle?              @relation(fields: [assignedVehicleId], references: [id], onDelete: SetNull)
  assignments     Assignment[]
  thread          Thread?
  settlements     Settlement[]
  schedule        DriverSchedule?
  timeOff         DriverShiftException[]

  @@unique([workspaceId, phoneUserId])
  @@unique([workspaceId, code])
  @@index([workspaceId, active, name])
  @@index([workspaceId, terminal])
  @@index([assignedVehicleId])
  @@map("drivers")
}

/// One driver and one pay per dispatched load (CONVERGENCE_BUILD_PLAN section 6). The pay shape is the bridge
/// contract's driver_pay: { kind: flat | cpm | hourly, rate }; `estimate` is display only.
/// status: draft | dispatched | accepted | declined | in_progress | completed.
model Assignment {
  id                     String    @id @default(cuid())
  loadId                 String    @unique @map("load_id")
  driverId               String    @map("driver_id")
  payKind                String    @map("pay_kind")
  payRate                Decimal   @map("pay_rate") @db.Decimal(12, 4)
  payEstimate            Decimal?  @map("pay_estimate") @db.Decimal(12, 2)
  status                 String    @default("draft")
  assignmentVersion      Int       @default(1) @map("assignment_version")
  driverResponse         Json?     @map("driver_response")
  dispatchedAt           DateTime? @map("dispatched_at")
  respondedAt            DateTime? @map("responded_at")
  /// The driver link: the bridge row this assignment is on, the last execution version of it the desk applied, when it last went through, and why a delivery failed (a word, never a body).
  bridgeDispatchId       String?   @map("bridge_dispatch_id")
  bridgeExecutionVersion Int       @default(0) @map("bridge_execution_version")
  bridgeSyncedAt         DateTime? @map("bridge_synced_at")
  bridgeError            String?   @map("bridge_error")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  load   Load   @relation(fields: [loadId], references: [id], onDelete: Cascade)
  driver Driver @relation(fields: [driverId], references: [id], onDelete: Restrict)

  @@index([driverId, status])
  @@index([status])
  @@map("assignments")
}

/// What the desk did and why: assignments, sends, driver answers, unassignments, invoices, payments and rate-confirmation
/// saves. `loadId` is a plain column (no foreign key) and `loadNumber` is copied in, so the trail outlives a deleted load.
/// `before` / `after` are small label-to-value objects shown as a diff; `reason` is the dispatcher's own words.
model AuditEvent {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  loadId      String?  @map("load_id")
  loadNumber  String?  @map("load_number")
  entity      String
  /// The record the event is about (a trailer's id), so a record's history is found by id and not by matching words. Older events leave it blank.
  entityId    String?  @map("entity_id")
  action      String
  summary     String
  reason      String?
  before      Json?
  after       Json?
  actor       String   @default("Dispatcher")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, action, createdAt])
  @@index([entityId, createdAt])
  @@index([loadId, createdAt])
  @@map("audit_events")
}

/// A driver's pay statement for a period. A draft lists the driver's delivered loads in the period (worked out from the loads each time it is
/// shown) with typed hours for hourly pay and typed adjustments; finalizing freezes the load lines, the adjustments and the total, and ties each
/// load to the statement so it cannot be paid twice. Voiding a final statement releases its loads and keeps the statement as it was.
/// status: draft | final | void. The period is two Dallas calendar dates.
model Settlement {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  driverId    String    @map("driver_id")
  number      String
  status      String    @default("draft")
  periodStart DateTime  @map("period_start") @db.Date
  periodEnd   DateTime  @map("period_end") @db.Date
  /// Draft only: the hours typed for hourly loads, by load id.
  hours       Json?
  /// Typed lines other than loads, [{ label, amount }] with the amount signed (a deduction is negative).
  adjustments Json?
  /// Final or void: the load lines as they were when it was finalized.
  lines       Json?
  total       Decimal?  @db.Decimal(12, 2)
  finalizedAt DateTime? @map("finalized_at")
  voidedAt    DateTime? @map("voided_at")
  voidReason  String?   @map("void_reason")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  workspace        Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  driver           Driver            @relation(fields: [driverId], references: [id], onDelete: Restrict)
  loads            SettlementLoad[]
  /// When the statement was sent to payroll, and the reference payroll gave it. Blank until sent.
  /// Fuel card purchases deducted on this statement: the ids picked while it is a draft, and the ledger as it was when it was finalized.
  fuelIds          Json?             @map("fuel_ids")
  fuel             Json?
  fuelTransactions FuelTransaction[]
  payrollSentAt    DateTime?         @map("payroll_sent_at")
  payrollReference String?           @map("payroll_reference")
  /// When the driver was paid, and how, when it was not through payroll (a check, a transfer). A statement paid either way cannot be voided.
  paidAt           DateTime?         @map("paid_at")
  paidMethod       String?           @map("paid_method")

  @@unique([workspaceId, number])
  @@index([workspaceId, status])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, finalizedAt])
  @@index([driverId])
  @@map("settlements")
}

/// A load paid on a final statement. One row per load at most, which is what stops a load being paid twice; voiding the statement deletes its rows.
model SettlementLoad {
  id           String  @id @default(cuid())
  settlementId String  @map("settlement_id")
  loadId       String  @unique @map("load_id")
  amount       Decimal @db.Decimal(12, 2)

  settlement Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  load       Load       @relation(fields: [loadId], references: [id], onDelete: Restrict)

  @@index([settlementId])
  @@map("settlement_loads")
}

/// A trailer unit in the registry: owned, leased, a customer's or a pool trailer. Desk-only (the phone has no trailer record). It is hooked to at most one
/// tractor at a time (a partial unique index) and can be put on a load; its registration and inspection dates feed the same alerts a driver's cards do.
/// status: available | in_shop | out_of_service. "On a load" is read from the open loads, not stored.
model Trailer {
  id                 String    @id @default(cuid())
  workspaceId        String    @map("workspace_id")
  number             String
  type               String?
  plate              String?
  plateState         String?   @map("plate_state")
  vin                String?
  ownership          String    @default("owned")
  lengthFt           Decimal?  @map("length_ft") @db.Decimal(8, 2)
  widthIn            Decimal?  @map("width_in") @db.Decimal(8, 2)
  tareLbs            Int?      @map("tare_lbs")
  maxPayloadLbs      Int?      @map("max_payload_lbs")
  axles              Int?
  hasLiftgate        Boolean   @default(false) @map("has_liftgate")
  hasETrack          Boolean   @default(false) @map("has_e_track")
  status             String    @default("available")
  terminal           String?
  location           String?
  currentVehicleId   String?   @map("current_vehicle_id")
  /// Where the trailer is: with its tractor while hooked, where it was dropped once unhooked. `unhookedAt` starts the dwell clock; cleared when it is hooked again.
  lastLat            Decimal?  @map("last_lat") @db.Decimal(9, 6)
  lastLng            Decimal?  @map("last_lng") @db.Decimal(9, 6)
  lastLocatedAt      DateTime? @map("last_located_at")
  hookedAt           DateTime? @map("hooked_at")
  unhookedAt         DateTime? @map("unhooked_at")
  /// A person's own dwell figure for this stay, which always beats the company's: a rate a day, the billable days, or the whole fee waived. Cleared when the trailer is hooked again.
  dwellRateOverride  Decimal?  @map("dwell_rate_override") @db.Decimal(8, 2)
  dwellDaysOverride  Decimal?  @map("dwell_days_override") @db.Decimal(6, 2)
  dwellWaived        Boolean   @default(false) @map("dwell_waived")
  dwellOverrideNote  String?   @map("dwell_override_note")
  dwellOverrideBy    String?   @map("dwell_override_by")
  dwellOverrideAt    DateTime? @map("dwell_override_at")
  registrationExpiry DateTime? @map("registration_expiry")
  inspectionExpiry   DateTime? @map("inspection_expiry")
  notes              String?
  archivedAt         DateTime? @map("archived_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  currentVehicle Vehicle?  @relation(fields: [currentVehicleId], references: [id], onDelete: SetNull)
  loads          Load[]
  checkCalls     CheckCall[]
  moves          TrailerMove[]

  @@index([workspaceId, archivedAt, number])
  @@index([workspaceId, terminal])
  @@index([workspaceId, status])
  @@index([currentVehicleId])
  @@map("trailers")
}

/// Which company a workspace has connected for a capability (factoring, eld, fuel_card, tracking, vetting, payroll, ifta). No credential is stored here:
/// the company's keys are server secrets, and this row only says the connection was made and its state.
model PartnerConnection {
  id           String    @id @default(cuid())
  workspaceId  String    @map("workspace_id")
  capability   String
  provider     String
  status       String    @default("connected")
  accountLabel String?   @map("account_label")
  lastError    String?   @map("last_error")
  connectedAt  DateTime? @map("connected_at")
  /// Health: when the company last answered, how many calls in a row have failed, and when the schedule next asks (docs/PARTNER_BACKBONE.md).
  lastSyncedAt DateTime? @map("last_synced_at")
  failures     Int       @default(0)
  nextSyncAt   DateTime? @map("next_sync_at")
  /// The unguessable part of this connection's webhook address: the company posts to /partners/webhook/<provider>/<token>, which finds the fleet without trusting the body.
  webhookToken String?   @unique @map("webhook_token")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, capability, provider])
  @@map("partner_connections")
}

/// A fleet's own keys for a partner company, encrypted at rest (AES-256-GCM, a server key outside the database). Only `hints` (the last four characters of each field) ever leave the server.
model PartnerCredential {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  provider    String
  /// "v1.<iv>.<tag>.<ciphertext>" of a JSON object of secret name to value. Never returned by any query the screens use.
  sealed      String
  /// Secret name to "...abcd": what the screen may show.
  hints       Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, provider])
  @@map("partner_credentials")
}

/// Every event a company's webhook has sent, once: the company's own event id is unique per provider, so a repeat is recognised and ignored. No body is kept (it can hold names and addresses): the kind and an outcome.
model PartnerEvent {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  provider    String
  eventId     String   @map("event_id")
  kind        String
  /// applied | ignored | failed
  outcome     String
  detail      String?
  receivedAt  DateTime @default(now()) @map("received_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([provider, eventId])
  @@index([workspaceId, receivedAt])
  @@map("partner_events")
}

/// What still has to be told to a driver's phone: written in the same transaction as the desk change it follows (send, change, reassign, unassign), then delivered and retried by the flusher.
/// No payload is kept: the summary is rebuilt from the load at delivery time, so a late delivery sends the current truth, checked again for anything a driver must not see.
model BridgeOutbox {
  id            String    @id @default(cuid())
  workspaceId   String    @map("workspace_id")
  loadId        String    @map("load_id")
  /// dispatch | update | reassign_old | cancel
  kind          String
  /// The driver the row is for (their phone account), so a reassign can say who is being taken off.
  phoneUserId   String    @map("phone_user_id")
  /// The bridge row to supersede or cancel (reassign_old and cancel), else null.
  dispatchId    String?   @map("dispatch_id")
  /// pending | done | failed
  status        String    @default("pending")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at")
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at")
  doneAt        DateTime? @map("done_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, nextAttemptAt])
  @@index([loadId])
  @@map("bridge_outbox")
}

/// The desk's conversation with one driver: one thread per driver, newest message last. A message can be about a load (its chip links to it).
/// Today nothing carries a message to the driver's phone, so `Message.deliveredAt` stays empty and the screen says the message is saved on the desk only.
model Thread {
  id            String   @id @default(cuid())
  workspaceId   String   @map("workspace_id")
  driverId      String   @unique @map("driver_id")
  lastMessageAt DateTime @default(now()) @map("last_message_at")
  createdAt     DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  driver    Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([workspaceId, lastMessageAt])
  @@map("threads")
}

/// One message in a thread. direction: out (the dispatcher wrote it) | in (the driver wrote it) | system (the desk noted something, such as a load being sent).
/// `clientId` is the browser's own id for a send, so a double click or a retry saves it once. `readAt` matters for `in`: empty means the dispatcher has not opened it.
model Message {
  id          String    @id @default(cuid())
  threadId    String    @map("thread_id")
  direction   String
  body        String
  loadId      String?   @map("load_id")
  clientId    String?   @map("client_id")
  sentAt      DateTime  @default(now()) @map("sent_at")
  deliveredAt DateTime? @map("delivered_at")
  readAt      DateTime? @map("read_at")

  thread      Thread              @relation(fields: [threadId], references: [id], onDelete: Cascade)
  load        Load?               @relation(fields: [loadId], references: [id], onDelete: SetNull)
  attachments MessageAttachment[]

  @@unique([threadId, clientId])
  @@index([threadId, sentAt])
  @@index([direction, readAt])
  @@map("messages")
}

/// A person on a desk. Sign-in proves who someone is (the provider's user id); this says which workspace they work in and as what: viewer, dispatcher or owner. A person is added
/// by an owner (or by whoever provisions the workspace) with an email before they have signed in; the first verified sign-in with that email binds the provider's user id,
/// and from then on the user id is what is matched. A plan holds only so many people (seats).
model Member {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  email       String
  name        String
  role        String    @default("dispatcher")
  /// Extra things an admin lets this person do on top of their role (only "bill" for a dispatcher: the billing office's work). Unknown values are ignored when read.
  grants      String[]  @default([])
  /// The sign-in provider's user id; null until the person first signs in. One person is on one desk.
  clerkUserId String?   @unique @map("clerk_user_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  lastSeenAt  DateTime? @map("last_seen_at")

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  scopes    MemberScope[]

  @@unique([workspaceId, email])
  @@index([email])
  @@map("members")
}

/// Someone who asked for an account. Not tied to a workspace: it exists before one does. kind: self_serve (under 50 trucks) | enterprise (50 or more: a person sets
/// them up). The kind is worked out from `trucks` on the server, never taken from the form. status: open | contacted | provisioned | declined; `workspaceId`
/// names the workspace made for them once provisioned (a plain column, so removing a workspace never removes the record that it was asked for).
model SignupRequest {
  id          String   @id @default(cuid())
  kind        String
  name        String
  company     String
  role        String?
  email       String
  phone       String?
  trucks      Int
  mcNumber    String?  @map("mc_number")
  bestTime    String?  @map("best_time")
  note        String?
  status      String   @default("open")
  workspaceId String?  @map("workspace_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([status, kind, createdAt])
  @@map("signup_requests")
}

/// A payment received against an invoice: the amount, the day it came in (Dallas calendar, kept as a timestamp) and how. An invoice paid in part has one or more of these and stays
/// out with a balance; the load's `paidAmount` is their sum. `kind` is payment, or the last row of an invoice closed short on purpose is still a payment (what was written off is the
/// difference, kept with its reason in the audit entry). Taking a payment back removes its row.
model LoadPayment {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  loadId      String   @map("load_id")
  amount      Decimal  @db.Decimal(12, 2)
  paidAt      DateTime @map("paid_at")
  method      String?
  createdAt   DateTime @default(now()) @map("created_at")

  load Load @relation(fields: [loadId], references: [id], onDelete: Cascade)

  @@index([loadId])
  @@index([workspaceId])
  @@map("load_payments")
}

/// A document kept on a load: the rate confirmation it was booked from, the proof of delivery, a receipt, anything else. The bytes are in the desk's private storage (never a public
/// address); this row names them (`storageKey`), says what they are (`kind`: rate_con | pod | receipt | other) and what they were checked to be (type, size, SHA-256). Factoring
/// reads these rows to know what it can send: a document that is not here is not in the packet.
model LoadDocument {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  loadId      String   @map("load_id")
  kind        String
  name        String
  mime        String
  bytes       Int
  sha256      String
  storageKey  String   @map("storage_key")
  addedBy     String   @map("added_by")
  /// The delivery stop a proof of delivery belongs to, when it is one stop's.
  stopId      String?  @map("stop_id")
  createdAt   DateTime @default(now()) @map("created_at")

  load Load @relation(fields: [loadId], references: [id], onDelete: Cascade)

  @@index([loadId])
  @@index([workspaceId])
  @@map("load_documents")
}

/// A picture or a file on a message (the phone's own limits: up to 4 a message, 10 MB each). kind: image | file. `storageKey` names the bytes in the desk's private
/// storage (never a public address); `sha256` is of the stored bytes. The type was checked against the file's real signature before it was kept.
model MessageAttachment {
  id         String   @id @default(cuid())
  messageId  String   @map("message_id")
  kind       String
  name       String?
  mime       String
  bytes      Int
  sha256     String
  storageKey String   @map("storage_key")
  createdAt  DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("message_attachments")
}

/// One claimed unit of paid-service spend (spend-guardrails plan, docs/platform/SPEND_GUARDRAILS.md): a rate-confirmation read, a Mapbox call. Written BEFORE the paid call by
/// server/tl/usage.ts `claimUsage` (one caller at a time per service) and removed again if the call never happened. `workspaceId` is a plain column (usage outlives a workspace),
/// `estCents` an estimate used only for the monthly dollar ceiling. Rows older than 70 days are deleted as claims are made.
model ServiceUsage {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  service     String
  units       Int      @default(1)
  estCents    Int      @default(0) @map("est_cents")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([service, createdAt])
  @@index([workspaceId, service, createdAt])
  @@map("service_usage")
}

/// A quarter's fuel-tax miles and gallons for one state (IFTA), as the mileage company worked them out from the quarter's delivered loads. Replaced as a whole each time the quarter is worked out,
/// so it is always one answer: the state-by-state mileage store (docs/PARTNER_BACKBONE.md). `gallons` is fuel consumed from the miles, not fuel bought.
model IftaLine {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  /// "2026-Q3".
  quarter     String
  state       String
  miles       Decimal  @db.Decimal(12, 1)
  gallons     Decimal  @db.Decimal(12, 2)
  /// The company that worked it out.
  source      String
  /// How many delivered loads the quarter's miles came from.
  loads       Int
  computedAt  DateTime @map("computed_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, quarter, state])
  @@map("ifta_lines")
}

/// A fuel card purchase, as the card company reported it: kept so fuel can be listed, tied to the load it was bought for and followed to the driver statement that load is on. One row per
/// purchase (the company's own id), so reading the same days twice never doubles it. `amount` is what the card was charged after the discount.
model FuelTransaction {
  id                String   @id @default(cuid())
  workspaceId       String   @map("workspace_id")
  provider          String
  externalId        String   @map("external_id")
  vehicleId         String?  @map("vehicle_id")
  loadId            String?  @map("load_id")
  postedAt          DateTime @map("posted_at")
  location          String?
  gallons           Decimal? @db.Decimal(10, 3)
  pricePerGallon    Decimal? @map("price_per_gallon") @db.Decimal(8, 4)
  discountPerGallon Decimal? @map("discount_per_gallon") @db.Decimal(8, 4)
  discount          Decimal? @db.Decimal(12, 2)
  amount            Decimal  @db.Decimal(12, 2)
  createdAt         DateTime @default(now()) @map("created_at")

  workspace    Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  vehicle      Vehicle?    @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  load         Load?       @relation(fields: [loadId], references: [id], onDelete: SetNull)
  /// The driver statement this purchase was deducted on (set when that statement is finalized, cleared if it is voided). A purchase is deducted once.
  settlementId String?     @map("settlement_id")
  settlement   Settlement? @relation(fields: [settlementId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, provider, externalId])
  @@index([workspaceId, postedAt])
  @@index([loadId])
  @@index([settlementId])
  @@map("fuel_transactions")
}

/// A terminal (yard, branch, region) as a named list the desk manages. Drivers, trucks and trailers keep their `terminal` text column, which now holds one of these names; a driver's terminal is
/// their home base, not a fence (anyone can be assigned a load from anywhere). Seeded from the distinct values in use. Names are unique per workspace regardless of case (an index on lower(name)).
model Terminal {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  name        String
  city        String?
  note        String?
  /// The region this terminal belongs to, or none yet (shown as "Unassigned"). Units stay assigned to a terminal; a region only groups terminals.
  regionId    String?   @map("region_id")
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  region    Region?   @relation(fields: [regionId], references: [id], onDelete: SetNull)

  @@index([workspaceId, archivedAt])
  @@index([regionId])
  @@map("terminals")
}

/// A group of terminals (Texas, the Southeast): what a dispatcher, a driver manager or an admin can be pointed at, so a big fleet is read one region at a time. A region owns no trucks or drivers; they stay
/// assigned to a terminal, and a terminal belongs to at most one region. Retiring a region leaves its terminals unassigned.
model Region {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  name        String
  note        String?
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  terminals Terminal[]
  scopes    MemberScope[]

  @@index([workspaceId, archivedAt])
  @@map("regions")
}

/// What a member may see: a region (all its terminals) or one terminal, by name. A member with no rows is not limited (and an admin never is). The server enforces it on every list; the header's scope
/// is a choice inside what is allowed, never a way out of it.
model MemberScope {
  id        String   @id @default(cuid())
  memberId  String   @map("member_id")
  regionId  String?  @map("region_id")
  /// A terminal's name, kept in step when the terminal is renamed.
  terminal  String?
  createdAt DateTime @default(now()) @map("created_at")

  member Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  region Region? @relation(fields: [regionId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@map("member_scopes")
}

/// A driver's weekly shift template on the carrier's clock. `week` is seven entries Sunday to Saturday, each `{ "start": minutes, "end": minutes }` for a shift that starts that day (an end at or before
/// the start runs past midnight into the next morning) or null for a day off. No row means no schedule set: the driver is neither on nor off, and is never flagged.
model DriverSchedule {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  driverId    String   @unique @map("driver_id")
  week        Json
  setBy       String?  @map("set_by")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  driver    Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("driver_schedules")
}

/// One date that differs from the template: time off, home time (kind off) or a different shift for that day (kind shift, with its start and end in minutes). `dateKey` is the day the shift starts, YYYY-MM-DD on the carrier's clock.
model DriverShiftException {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  driverId    String   @map("driver_id")
  dateKey     String   @map("date_key")
  kind        String
  startMinute Int?     @map("start_minute")
  endMinute   Int?     @map("end_minute")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  driver    Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([driverId, dateKey])
  @@index([workspaceId, dateKey])
  @@map("driver_shift_exceptions")
}

/// One position fix from the ELD for a tractor, kept for a week: the breadcrumb on a load's tracking tab, and where the idle time went. Unique per (vehicle, instant) so a re-read never writes it twice.
model VehiclePing {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  vehicleId   String   @map("vehicle_id")
  lat         Decimal  @db.Decimal(9, 6)
  lng         Decimal  @db.Decimal(9, 6)
  speedMph    Decimal? @map("speed_mph") @db.Decimal(5, 1)
  headingDeg  Int?     @map("heading_deg")
  engine      String?
  at          DateTime
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, at])
  @@index([vehicleId, at(sort: Desc)])
  @@index([workspaceId, at])
  @@map("vehicle_pings")
}

/// A call to a driver, or a word from one, about where a truck or trailer is and when it will get there. A business record kept with the asset: it is how a late load or a detention claim is settled
/// later. `at` is when the call happened (a dispatcher can back-date it); `createdAt` is when it was typed in. Nothing here is read by money, the quote or the verdict.
model CheckCall {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  vehicleId   String?   @map("vehicle_id")
  trailerId   String?   @map("trailer_id")
  loadId      String?   @map("load_id")
  at          DateTime
  /// What the driver said about where they are: "I-40 past Amarillo", "in the yard, door 4".
  place       String?
  /// When the driver said they would arrive.
  etaAt       DateTime? @map("eta_at")
  /// on_time, late or issue; blank when not said.
  status      String?
  note        String?
  spokeWith   String?   @map("spoke_with")
  loggedBy    String    @map("logged_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  vehicle   Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  trailer   Trailer?  @relation(fields: [trailerId], references: [id], onDelete: Cascade)
  load      Load?     @relation(fields: [loadId], references: [id], onDelete: SetNull)

  @@index([vehicleId, at(sort: Desc)])
  @@index([trailerId, at(sort: Desc)])
  @@index([loadId, at])
  @@index([workspaceId, at])
  @@map("check_calls")
}

/// A stretch of time a tractor stood in one place (engine off or idling, at least twenty minutes), written as the ELD is read: it opens when the tractor stops, grows while it stays, and closes with
/// `leftAt` when it moves on. Raw fixes are kept a week (VehiclePing); these are what is kept for the longer record of where a truck has been and when.
model UnitStay {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  vehicleId   String    @map("vehicle_id")
  lat         Decimal   @db.Decimal(9, 6)
  lng         Decimal   @db.Decimal(9, 6)
  arrivedAt   DateTime  @map("arrived_at")
  /// The last fix that still put it here.
  lastSeenAt  DateTime  @map("last_seen_at")
  /// Set when a fix puts it somewhere else; blank while it is still there.
  leftAt      DateTime? @map("left_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, arrivedAt(sort: Desc)])
  @@index([workspaceId, arrivedAt])
  @@map("unit_stays")
}

/// A trailer hooked to a tractor or dropped, with where the tractor was at that moment, so a trailer's trail (which tractor pulled it, where it was left, how long it sat) can be read back.
model TrailerMove {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  trailerId   String   @map("trailer_id")
  /// The tractor it was hooked to, or dropped from.
  vehicleId   String?  @map("vehicle_id")
  /// hooked or dropped.
  kind        String
  at          DateTime
  lat         Decimal? @db.Decimal(9, 6)
  lng         Decimal? @db.Decimal(9, 6)
  byName      String   @map("by_name")
  createdAt   DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  trailer   Trailer   @relation(fields: [trailerId], references: [id], onDelete: Cascade)
  vehicle   Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([trailerId, at(sort: Desc)])
  @@index([vehicleId, at(sort: Desc)])
  @@map("trailer_moves")
}

/// What a lane should pay per load, set by a person (the lane is the KPI's own key, "origin -> destination"). The Lanes scorecard compares each lane's revenue per load with it: BELOW, OK, or no target.
model LaneTarget {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  lane        String
  /// Dollars per load, all in.
  targetRate  Decimal  @map("target_rate") @db.Decimal(12, 2)
  setBy       String?  @map("set_by")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, lane])
  @@map("lane_targets")
}

/// The weekly on-highway diesel price (EIA), kept whenever the desk reads it, so the fuel surcharge summary can compare this week with last. Shared by every fleet (a public price, no workspace).
model DieselPrice {
  id        String   @id @default(cuid())
  /// The EIA week (a date, YYYY-MM-DD) and the region it is for (NUS national, R10 to R50 regional).
  weekOf    String   @map("week_of")
  region    String
  price     Decimal  @db.Decimal(6, 3)
  fetchedAt DateTime @default(now()) @map("fetched_at")

  @@unique([weekOf, region])
  @@map("diesel_prices")
}

/// "Notes for the call": what the person wants said about a week when the report is read out, one per week (`weekKey` is the Monday, YYYY-MM-DD, on the workspace's clock).
model KpiNote {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  weekKey     String   @map("week_key")
  body        String
  updatedBy   String?  @map("updated_by")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, weekKey])
  @@map("kpi_notes")
}

/// One lane's week from a carrier's own weekly tracker (a spreadsheet of lane-per-week totals, not a list of loads). It feeds the trends only and is shown as "imported history": it is never turned into loads and
/// never added to a figure built from loads. `weekStart` is the Monday of the week. A batch is every row of one file, so an import can be taken away whole.
model ImportedHistory {
  id               String   @id @default(cuid())
  workspaceId      String   @map("workspace_id")
  batchId          String   @map("batch_id")
  weekStart        DateTime @map("week_start") @db.Date
  lane             String
  loads            Int
  lineHaul         Decimal  @map("line_haul") @db.Decimal(12, 2)
  fuelSurcharge    Decimal  @default(0) @map("fuel_surcharge") @db.Decimal(12, 2)
  loadedMiles      Decimal  @map("loaded_miles") @db.Decimal(12, 1)
  emptyMiles       Decimal  @default(0) @map("empty_miles") @db.Decimal(12, 1)
  source           String
  createdAt        DateTime @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, weekStart, lane])
  @@index([workspaceId, batchId])
  @@map("imported_history")
}
